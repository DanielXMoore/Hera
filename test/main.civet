assert from assert
typescript from typescript
{ readFile } from ./helper.civet
hera, { compile, execMod, generate, modImport, parse, parseTokens } from ../source/main.civet
{ transpileTsEmbedded, transpileTsToJs } from ../source/register/tsc/transpile.civet
{ EOL } from node:os
{ SourceMap } from ../source/sourcemap.civet
civet from @danielx/civet
esbuild from esbuild

describe "Hera", ->
  it "should do math example", ->
    grammar := readFile("samples/math.hera")
    parser := generate(grammar)

    result := parser.parse """
      8 + 3 / (2 + 5)
    """

    assert.equal result, 8 + 3 / 7

  it "should do url example", ->
    grammar := readFile("samples/url.hera")
    parser := generate(grammar)

    {scheme, fragment, host, path, port, query} := parser.parse """
      http://danielx.net:443/%21?query#fragment
    """

    assert.equal scheme, "http"
    assert.equal host, "danielx.net"
    assert.equal port, "443"
    assert.equal path, "/!"
    assert.equal query, "query"
    assert.equal fragment, "fragment"

  it "should parse code example", ->
    grammar := readFile("samples/code.hera")
    parser := generate(grammar)

    assert.equal parser.test, "hello"

    parser.parse "a"

  it "should consume blank lines as part of EOS", ->
    grammar := """
      Grammar
        Rule+ ->
          a = 5

          return a

      Rule
        Name StringLiteral? EOS (Indent Choice)+

    """

    assert hera.parse(grammar)

  it "should handle comments", ->
    grammar := """
      # Comment!
      # Comment


      Grammar # Comment!
        Rule # Another Comment!
      # 2Comment!
      Rule#Comment
        "a"#rad

      # comment
    """

    parser := generate(grammar)
    assert parser.parse("a")

  it "should preserve hash-prefixed handler lines", ->
    rules := hera.parse """
      Rule
        "a" ->
          # comment
          return 1
          # comment 2
    """

    assert typeof rules.Rule[2] is "object" and "f" in rules.Rule[2]
    assert.equal rules.Rule[2].f, "    # comment\n    return 1\n    # comment 2"

  it "should preserve hash-prefixed inline handler lines", ->
    rules := hera.parse """
      Rule
        "a" -> {
          # comment 1
          value: 1,
          # comment 2
        }.value
    """

    assert typeof rules.Rule[2] is "object" and "f" in rules.Rule[2]
    assert.equal rules.Rule[2].f, "{\n    # comment 1\n    value: 1,\n    # comment 2\n  }.value"

  it "should treat a trailing comment after -> as a block handler", ->
    // Regression: when the grammar places a `# comment` on the same line as
    // `->`, Hera used to capture the comment as if it were the inline
    // handler body and then prepend `return `, producing
    // `return # comment\n  return 1` in the emitted handler.  The real body
    // should be the indented block below, and the trailing comment must not
    // contaminate it.
    parser := generate """
      Rule
        "a" -> # trailing comment
          return 1
    """
    assert.equal parser.parse("a"), 1

  it "should not shadow module-level free variables named state/ctx", ->
    // Regression: handlers are emitted as an IIFE inside the rule function,
    // which takes `(ctx, state)` as parameters.  If the handler body
    // references a module-level free variable that happens to also be named
    // `state` or `ctx` (common in parsers that keep parse-time mutable
    // state at module scope — e.g. Civet's parser.hera keeps
    // `state.indentLevels`, `config`, etc.), the IIFE's lexical scope
    // captures the rule function's parameter and the handler silently
    // writes to the wrong object.
    //
    // Assert on the emitted code so we don't silently regress: the rule
    // function's parameters must NOT be plain `ctx` / `state`.
    code := compile """
      Rule
        "a" -> 1
    """
    assert.doesNotMatch code, /function Rule\(ctx,\s*state\)/
    assert.doesNotMatch code, /function Rule\(ctx:\s*\w+,\s*state:\s*\w+\)/

  it "should allow a type annotation with no handler", ->
    // `Rule\n  Name ::Type` should parse and compile the same as
    // `Rule\n  Name` — the `::Type` is advisory only and does not introduce
    // a handler (the rule's return value is the sub-parser's result).
    grammar := """
      Rule
        Inner ::any

      Inner
        "x" -> 42
    """
    parser := generate grammar
    assert.equal parser.parse("x"), 42

    // With `types: true`, the annotation should flow into the emitted
    // rule's return type so recursive grammars don't fall back to `unknown`.
    code := compile grammar, types: true
    assert.match code, /function Rule\(\$\$ctx: ParserContext, \$\$state: ParseState\): MaybeResult<any>/

  it "should keep a single typed expression's default return value", ->
    parser := generate """
      Rule
        Inner ::string

      Inner
        "x" -> "value"
    """
    assert.equal parser.parse("x"), "value"

  it "should keep a typed sequence's default return value", ->
    parser := generate """
      Rule
        A B ::[string, string]

      A
        "a"
      B
        "b"
    """
    assert.deepEqual parser.parse("ab"), ["a", "b"]

  it "should allow a type annotation with no handler followed by comment", ->
    grammar := """
      Rule
        Inner ::any
        # Comment
        Another

      Inner
        "x" -> 42
      Another
        "x" -> 43
    """
    parser := generate grammar
    assert.equal parser.parse("x"), 42

    // With `types: true`: this is a top-level choice where only one
    // alternative carries a `::Type`, so no rule-level annotation is emitted
    // (TS infers the union from the body via `??` chaining instead).
    code := compile grammar, types: true
    assert.match code, /function Rule\(\$\$ctx: ParserContext, \$\$state: ParseState\) \{/
    assert.doesNotMatch code, /function Rule\(\$\$ctx: ParserContext, \$\$state: ParseState\): MaybeResult/

  it "should apply a rule-level type annotation to untyped alternatives", ->
    grammar := """
      Rule ::Default
        "a" -> "a"
        "b" ::Specific -> "b"
        Inner
        "d"

      Inner
        "c" -> "c"
    """
    rules := parse grammar

    assert.equal rules.Rule[1][0][2].t.trim(), "Default"
    assert.equal rules.Rule[1][1][2].t.trim(), "Specific"
    assert.equal rules.Rule[1][2][2].t.trim(), "Default"
    assert.equal rules.Rule[1][3][2].t.trim(), "Default"

    parser := generate grammar
    assert.equal parser.parse("a"), "a"
    assert.equal parser.parse("b"), "b"
    assert.equal parser.parse("c"), "c"
    assert.equal parser.parse("d"), "d"

    code := compile grammar, types: true
    assert.match code, /function Rule\(\$\$ctx: ParserContext, \$\$state: ParseState\): MaybeResult<Default \| Specific>/

    singleRules := parse """
      Single ::Only
        "s"
    """
    assert.equal singleRules.Single[2].t.trim(), "Only"

  it "should compile multi-line inline handler bodies", ->
    // Regression: an inline handler body that spans multiple lines
    // (`-> { ... }` with the object contents below) must emit code that's
    // valid in indent-sensitive downstream parsers (Civet consumes Hera's
    // output this way).  The continuation lines of a multi-line inline
    // handler must be strictly deeper than the IIFE's statement indent, or
    // Civet treats them as a new statement instead of object properties.
    //
    // First: the emitted parser must still work at runtime.
    parser := generate """
      Rule
        "a" -> {
          type: "X",
          value: 1,
        }
    """
    assert.deepEqual parser.parse("a"), { type: "X", value: 1 }

    // Second: inspect the emitted code.  After the `return {` line inside
    // the handler IIFE, every continuation line up to and including the
    // matching `}` must be indented strictly deeper than the `return`.
    code := compile """
      Rule
        "a" -> {
          type: "X",
          value: 1,
        }
    """
    lines := code.split("\n")
    returnIdx := lines.findIndex (l) -> /^\s+return\s*\{\s*$/.test l
    assert returnIdx >= 0, "expected a `return {` line in emitted handler"
    returnIndent := lines[returnIdx].match(/^(\s*)/)![1].length
    // Find the matching closing `}` (a line with fewer-or-equal indent).
    closeIdx .= -1
    for i of [returnIdx + 1...lines.length]
      indent := lines[i].match(/^(\s*)/)![1].length
      if /^\s*\}/.test(lines[i]) and indent <= returnIndent
        closeIdx = i
        break
    assert closeIdx > returnIdx, "expected closing `}` after `return {`"
    for i of [returnIdx + 1...closeIdx]
      continue if lines[i].trim() is ""
      indent := lines[i].match(/^(\s*)/)![1].length
      assert indent > returnIndent,
        `continuation line ${i} of inline handler must be deeper than return: ${JSON.stringify(lines[i])}`

  it "should handle rules that are aliases", ->
    grammar := """
      Grammar
        Alias Alias*

      Alias
        Terminal

      Terminal
        "."
    """

    parser := generate(grammar)
    assert parser.parse(".")

  it "should recursively generate itself", ->
    heraSrc := readFile('source/hera.hera')
    { parse: newHeraParse } := generate heraSrc, transpile: transpileTsToJs

    assert.deepEqual newHeraParse(heraSrc), parse(heraSrc)

    grammar := """
      Grammar
        Rule+

      Rule
        Name StringLiteral? EOS (Indent Choice)+

    """
    assert.deepEqual(newHeraParse(grammar), parse(grammar))

  it "should sourcemap", ->
    {code, sourceMap} := compile 'Rule\n  "a"', sourceMap: true

    assert code
    assert sourceMap

  it "should source map rule block handlers from the preserved line start", ->
    grammar := """
      Rule
        "abc" ->
          return 1
          x()
    """
    {code, sourceMap} := compile grammar, sourceMap: true
    lines := code.split("\n")
    returnLine := lines.findIndex((line) => line.includes("return 1"))
    callLine := lines.findIndex((line) => line.includes("x()"))

    assert returnLine >= 0, "compiled output should contain 'return 1'"
    assert callLine >= 0, "compiled output should contain 'x()'"

    assert.deepEqual sourceMap.lines[returnLine].find((entry) => entry.length > 1), [0, 0, 2, 0]
    assert.deepEqual sourceMap.lines[callLine].find((entry) => entry.length > 1), [0, 0, 3, 0]

  it "should sourcemap fenced code blocks", ->
    heraSrc := "```\nconst injectedCodeBlockValue = 12345;\n```\n\nRule\n  \"a\""
    {code, sourceMap} := compile heraSrc, sourceMap: true

    outputLine := code
      .split("\n")
      .findIndex (line) -> line.includes "const injectedCodeBlockValue = 12345;"

    assert.notEqual outputLine, -1
    assert sourceMap.lines[outputLine].some (entry) ->
      entry.length is 4 and entry[2] is 1 and entry[3] is 0

  it "should source map one-line handlers", ->
    grammar := """
      Start
        \"a\":left \"b\":right -> [left, right]
        /(c+)(d+)/ -> [$1, $2]
        \"t\" -> true
        \"n\" -> null
    """
    {code, sourceMap} := compile grammar, sourceMap: true
    lines := code.split("\n")
    sequenceLine := lines.findIndex (line) -> line.includes "return [left, right]"
    regexLine := lines.findIndex (line) -> line.includes "return [$1, $2]"
    trueLine := lines.findIndex (line) -> line.includes "return true"
    nullLine := lines.findIndex (line) -> line.includes "return null"

    assert sequenceLine >= 0, "compiled output should contain 'return [left, right]'"
    assert regexLine >= 0, "compiled output should contain 'return [$1, $2]'"
    assert trueLine >= 0, "compiled output should contain 'return true'"
    assert nullLine >= 0, "compiled output should contain 'return null'"

    assert sourceMap.lines[sequenceLine].some (entry) ->
      entry.length is 4 and entry[2] is 1 and entry[3] is 24
    assert sourceMap.lines[regexLine].some (entry) ->
      entry.length is 4 and entry[2] is 2 and entry[3] is 16
    assert sourceMap.lines[trueLine].some (entry) ->
      entry.length is 4 and entry[2] is 3 and entry[3] is 9
    assert sourceMap.lines[nullLine].some (entry) ->
      entry.length is 4 and entry[2] is 4 and entry[3] is 9

  it "should compile to ts", ->
    heraSrc := readFile('source/hera.hera')
    tsSrc := compile heraSrc, types: true

    assert tsSrc

  it "should add inline source map", ->
    heraSrc := readFile('source/hera.hera')
    tsSrc := compile heraSrc, types: true, inlineMap: true

    assert tsSrc.includes('//# sourceMappingURL=data:application/json;base64')

  it "should annotate simple regexp types when compiling", ->
    heraSrc := """
      Rule
        /abc/
    """
    tsSrc := compile hera.parse(heraSrc), types: true

    assert tsSrc.includes('$R<["abc"]>')

  it "should annotate rules with types with handlers ", ->
    heraSrc := """
      Rule
        "abc" ::MyType ->
          return new MyType
    """
    tsSrc := compile hera.parse(heraSrc), types: true

    assert tsSrc.includes('function Rule($$ctx: ParserContext, $$state: ParseState): MaybeResult<MyType>')

  it "unions the types of a choice rule whose alternatives all declare return types", ->
    heraSrc := """
      Rule
        "a" ::A ->
          return "a" as any as A
        "b" ::B ->
          return "b" as any as B
    """
    tsSrc := compile hera.parse(heraSrc), types: true

    assert tsSrc.includes('function Rule($$ctx: ParserContext, $$state: ParseState): MaybeResult<A | B>')

  it "numbered regex groups in mappings", ->
    grammar := """
      Start
        Group1
        Group2
        Group3
        Group4

      Group1
        /(a+)(b+)/ -> [$1, $2]

      Group2
        /(c+)(d+)/ ->
          return [$1, $2];

      Group3
        /123((456)789)/ -> [$3, $1, $2, $0]

      Group4
        /pp(qq)/ ->
          return $0 + $1
    """

    {parse} := generate(grammar)

    assert.deepEqual parse("aab"), ["aa", "b"]
    assert.deepEqual parse("cdd"), ["c", "dd"]
    assert.deepEqual parse("123456789"), [undefined, "456789", "456", "123456789"]
    assert.deepEqual parse("ppqq"), "ppqqqq"

  it "regex that may sometimes be empty with +", ->
    grammar := """
      Start
        Re+ ->
          return $0.join('')

      Re
        /a|b?/
    """

    {parse} := generate(grammar)
    assert.deepEqual parse("ab"), "ab"
    assert.deepEqual parse(""), ""
    assert.deepEqual parse("bb"), "bb"

  it "transitive regex", ->
    grammar := """
      Start
        Group*

      Group
        /(a?)(b+)c*/
    """

    {parse} := generate(grammar)

    assert.deepEqual parse(""), []
    assert.deepEqual parse("ab"), ["ab"]
    assert.deepEqual parse("ababccbc"), ["ab", "abcc", "bc"]

  it "should parse and match empty slash regexes", ->
    rules := parse """
      Empty
        //
    """
    assert.deepEqual rules.Empty, ["R", ""]
    assert.match compile(rules), /const \$R0 = \$R\(\/\(\?:\)\/suy\);/

    parser := generate """
      Empty
        // -> "empty"
    """
    assert.equal parser.parse(""), "empty"

  it "should parse bare character classes as regexes", ->
    rules := parse """
      Rule
        [a-z]+[1-9]*

      Flags
        [dgimsuy]

      Name
        [_a-zA-Z][_a-zA-Z0-9]*

      Quants
        [0-9]{3,4}

      Quant2
        [a]{2}

      EscapedSpace
        [\\ ]
    """

    assert.deepEqual rules.Rule, ["R", "[a-z]+[1-9]*"]
    assert.deepEqual rules.Flags, ["R", "[dgimsuy]"]
    assert.deepEqual rules.Name, ["R", "[_a-zA-Z][_a-zA-Z0-9]*"]
    assert.deepEqual rules.Quants, ["R", "[0-9]{3,4}"]
    assert.deepEqual rules.Quant2, ["R", "[a]{2}"]
    assert.deepEqual rules.EscapedSpace, ["R", "[ ]"]
    assert.match compile(rules), /const \$R0 = \$R\(\/\[a-z\]\+\[1-9\]\*\/suy\);/

  it "should normalize regexp source whitespace for JS literals", ->
    tab := "\t"
    lineSeparator := "\u2028"
    paragraphSeparator := "\u2029"
    grammar := ```
      SlashSpace
        /\\ /
      SlashTab
        /\\${tab}/
      SlashLineSeparator
        /a${lineSeparator}b/
      ClassSpace
        [\\ ]
      ClassTab
        [\\${tab}]
      ClassParagraphSeparator
        [a${paragraphSeparator}b]
    ```
    rules := parse grammar

    assert.deepEqual rules.SlashSpace, ["R", " "]
    assert.deepEqual rules.SlashTab, ["R", "\\t"]
    assert.deepEqual rules.SlashLineSeparator, ["R", "a\\u2028b"]
    assert.deepEqual rules.ClassSpace, ["R", "[ ]"]
    assert.deepEqual rules.ClassTab, ["R", "[\\t]"]
    assert.deepEqual rules.ClassParagraphSeparator, ["R", "[a\\u2029b]"]

    parser := generate grammar.replace(/(\n  [^\n]+)/g, "$1 -> $0")
    assert.equal parser.parse(" ", startRule: "SlashSpace"), " "
    assert.equal parser.parse(tab, startRule: "SlashTab"), tab
    assert.equal parser.parse("a" + lineSeparator + "b", startRule: "SlashLineSeparator"), "a" + lineSeparator + "b"
    assert.equal parser.parse(" ", startRule: "ClassSpace"), " "
    assert.equal parser.parse(tab, startRule: "ClassTab"), tab
    assert.equal parser.parse(paragraphSeparator, startRule: "ClassParagraphSeparator"), paragraphSeparator

  it "should parse static triple-slash regexes", ->
    tab := "\t"
    lineSeparator := "\u2028"
    paragraphSeparator := "\u2029"
    grammar := ```
      Rule
        ///  ab c / [ # ]  ///

      EscapedSpace
        ///\\ ///
      EscapedTab
        ///\\${tab}///
      EscapedLineSeparator
        ///\\${lineSeparator}///
      EscapedParagraphSeparator
        ///\\${paragraphSeparator}///
      UnescapedWhitespace
        ///a${tab}b${lineSeparator}c${paragraphSeparator}d///

      Identifier
        ///
          [A-Za-z_]
          [A-Za-z0-9_]*
        ///

      Commented
        ///
          [A-Za-z_] // first character
          [A-Za-z0-9_]* // the rest
        ///
    ```
    rules := parse grammar

    assert.deepEqual rules.Rule, ["R", "abc\\/[ # ]"]
    assert.deepEqual rules.EscapedSpace, ["R", " "]
    assert.deepEqual rules.EscapedTab, ["R", "\\t"]
    assert.deepEqual rules.EscapedLineSeparator, ["R", "\\u2028"]
    assert.deepEqual rules.EscapedParagraphSeparator, ["R", "\\u2029"]
    assert.deepEqual rules.UnescapedWhitespace, ["R", "abcd"]
    assert.deepEqual rules.Identifier, ["R", "[A-Za-z_][A-Za-z0-9_]*"]
    assert.deepEqual rules.Commented, ["R", "[A-Za-z_][A-Za-z0-9_]*"]

    parser := generate grammar.replace(/(\n  [^\n]+)/g, "$1 -> $0")
    assert.equal parser.parse(" ", startRule: "EscapedSpace"), " "
    assert.equal parser.parse(tab, startRule: "EscapedTab"), tab
    assert.equal parser.parse(lineSeparator, startRule: "EscapedLineSeparator"), lineSeparator
    assert.equal parser.parse(paragraphSeparator, startRule: "EscapedParagraphSeparator"), paragraphSeparator
    assert.equal parser.parse("abcd", startRule: "UnescapedWhitespace"), "abcd"

    empty := parse """
      Empty
        //////
    """
    assert.deepEqual empty.Empty, ["R", ""]

    emptyParser := generate """
      Empty
        ////// -> "empty"
    """
    assert.equal emptyParser.parse(""), "empty"

  it "should compile interpolated triple-slash regexes", ->
    {parse} := generate """
      ```
      const shared = "[0-9]+"
      ```

      Rule
        /// x y ${shared} /// -> $0

      Another
        /// a b ${shared} /// -> $0
    """

    assert.equal parse("xy123"), "xy123"
    assert.equal parse("ab456", startRule: "Another"), "ab456"
    assert.throws ->
      parse("xyabc")
    , /Rule \/xy\[0-9\]\+\//

  it "should compile const interpolated triple-slash regex parts", ->
    (globalThis as any).__heraConstPart = "[0-9]+"
    (globalThis as any).__heraDynamicPart = "a"
    try
      {parse} := generate """
        ```
        globalThis.__heraConstPart = "[0-9]+"
        globalThis.__heraDynamicPart = "a"
        ```

        Rule
          /// token-${ const globalThis.__heraConstPart}-${globalThis.__heraDynamicPart} /// -> $0
      """

      assert.equal parse("token-123-a"), "token-123-a"
      (globalThis as any).__heraConstPart = "[a-z]+"
      (globalThis as any).__heraDynamicPart = "b"
      assert.equal parse("token-456-b"), "token-456-b"
      assert.throws ->
        parse("token-abc-b")
      , /Rule \/token-\[0-9\]\+-b\//

      {parse: parseLexical} := generate """
        ```
        const lexicalConst = "[a-z]+"
        let lexicalDynamic = "x"
        ```

        Rule
          Lexical Set Lexical -> $1 + "|" + $3

        Lexical
          /// lexical-${const lexicalConst}-${lexicalDynamic} /// -> $0

        Set
          "" ->
            lexicalDynamic = "y"
            return ""
      """
      assert.equal parseLexical("lexical-abc-xlexical-abc-y"), "lexical-abc-x|lexical-abc-y"

      {parse: parseBalanced} := generate """
        ```
        const dynamic = "b"
        ```

        Rule
          /// token-${const ({ pattern: "[0-9]+" }).pattern}-${"}".replace("}", dynamic)} /// -> $0
      """
      assert.equal parseBalanced("token-123-b"), "token-123-b"
    finally
      delete (globalThis as any).__heraConstPart
      delete (globalThis as any).__heraDynamicPart

  // The rules hold the function that builds the regex, so it has to keep the
  // regex itself
  it "should build a regex whose interpolations are all const once", ->
    grammar := """
      ```
      let pattern = "a+"
      let reads = 0
      function readPattern() { reads++; return pattern }
      exports.setPattern = (p) => { pattern = p }
      exports.reads = () => reads
      ```
      Call
        /// ${const readPattern()} /// -> $0
      Identifier
        /// ${const pattern} /// -> $0
    """
    for transpileEmbedded of [undefined, ((src: string) -> src)]
      mod := execMod(compile(grammar, { transpileEmbedded })) as any
      assert.equal mod.parse("aa", startRule: "Call"), "aa"
      assert.equal mod.parse("aaa", startRule: "Identifier"), "aaa"
      mod.setPattern "b+"
      assert.equal mod.parse("aaaa", startRule: "Call"), "aaaa"
      assert.equal mod.parse("a", startRule: "Identifier"), "a"
      assert.throws (-> mod.parse("bb", startRule: "Call")), /Call \/a\+\//
      assert.throws (-> mod.parse("bb", startRule: "Identifier")), /Identifier \/a\+\//
      assert.equal mod.reads(), 1

  it "should reuse duplicated interpolated triple-slash regexes", ->
    code := compile parse """
      ```
      const shared = "[a-z]+"
      ```

      Rule
        /// ${shared} ///
        /// ${shared} ///
    """

    assert.match code, /const \$RD0 = /
    assert.doesNotMatch code, /const \$RD1 = /
    assert.match code, /\$EXPECT\(\$RD0, \(\) => `Rule \/\$\{\$RD0\.source\}\/`\)/
    constOnlyCode := compile parse """
      Rule
        /// ${const shared} ///
    """
    assert.match constOnlyCode, /const \$RD0 = /
    assert.match constOnlyCode, /\$RD0\.parser = \$R\(new RegExp/
    assert.match constOnlyCode, /const \$\$source = `\$\{shared\}`/
    assert.doesNotMatch constOnlyCode, /\$\$const0/

    mixedConstCode := compile parse """
      Rule
        /// ${ const shared }${dynamic} ///
    """
    assert.match mixedConstCode, /`\$\{shared\s*\}\$\{dynamic\}`/
    assert.doesNotMatch mixedConstCode, /\$\$const0/

    unicodeIdentifierConstCode := compile parse """
      ```
      const café = "[a-z]+"
      ```

      Rule
        /// ${ const café }${dynamic} ///
    """
    assert.match unicodeIdentifierConstCode, /`\$\{café\s*\}\$\{dynamic\}`/
    assert.doesNotMatch unicodeIdentifierConstCode, /\$\$const0/

    mixedComplexConstCode := compile parse """
      Rule
        /// ${const shared.slice(0)}${dynamic} ///
    """
    assert.match mixedComplexConstCode, /\$RD0\.const0 \?\?= String\(shared\.slice\(0\)\);[\s\S]*`\$\{\$RD0\.const0\}\$\{dynamic\}`/
    assert.doesNotMatch mixedComplexConstCode, /\(\(\) =>/
    assert.doesNotMatch mixedComplexConstCode, /\$\$const0/

    typedCode := compile parse("""
      Rule
        /// ${shared} ///
    """), types: true
    assert.match typedCode, /parser\?: Parser<RegExpMatchArray>/
    assert.match typedCode, /\{ source\?: string, parser\?: Parser<RegExpMatchArray> \}/

    typedConstCode := compile parse("""
      Rule
        /// ${const shared}${dynamic} ///
    """), types: true
    assert.doesNotMatch typedConstCode, /\$\$const0/

    typedComplexConstCode := compile parse("""
      Rule
        /// ${const shared.slice(0)}${dynamic} ///
    """), types: true
    assert.match typedComplexConstCode, /const0\?: string/
    assert.doesNotMatch typedComplexConstCode, /\$\$const0/

    typedConstOnlyCode := compile parse("""
      Rule
        /// ${const shared} ///
    """), types: true
    assert.match typedConstOnlyCode, /as Parser<RegExpMatchArray> & \{ source\?: string, parser\?: Parser<RegExpMatchArray> \}/
    assert.doesNotMatch typedConstOnlyCode, /\$\$const0/

  it "should treat hash interpolation syntax as static text in triple-slash regexes", ->
    {parse} := generate """
      Rule
        /// #\\{shared\\} ///
    """

    assert.equal parse("#{shared}"), "#{shared}"

  it "should parse simple grammars", ->
    {parse} := generate """
      Rule
        "A"+
        "B"+

    """

    parse "AAAAAA"
    parse "BBB"

    assert.throws ->
      parse "BBA"

    assert.throws ->
      parse "AAB"

  describe "-> Structural Result", ->
    it "should map to literals", ->
      {parse} := generate """
        Rule
          I J K N F T

        I
          "" -> 7

        J
          "" -> -3.1

        K
          "" -> 2.7

        N
          "" -> null

        F
          "" -> false

        T
          "" -> true
      """

      assert.deepEqual parse(""), [7, -3.1, 2.7, null, false, true]

    it "should properly encode string literals in object values", ->
      {parse} := generate """
        Rule
          "" -> "\\n"
      """

      assert.deepEqual parse(""), "\n"

    it "should allow for bare undefined", ->
      {parse} := generate """
        Rule
          "" -> undefined
      """

      assert.deepEqual parse(""), undefined

    it "should map regexp groups into the structure", ->
      {parse} := generate """
        Rule
          /(a)(b)(c)/ -> [$2, $3, $1]
      """

      assert.deepEqual ["b", "c", "a"], parse "abc"

    it "should map sequence items into the structure", ->
      {parse} := generate """
        Rule
          "A" "B" "C" -> [$2, $3, $1]
      """

      assert.deepEqual ["B", "C", "A"], parse "ABC"

    it "should map array of sequence as $0", ->
      {parse} := generate """
        Rule
          "A" "B" "C" -> $0
      """

      assert.deepEqual ["A", "B", "C"], parse "ABC"

    it "should map the entire result as $1", ->
      {parse} := generate """
        Rule
          Sub* -> ["T", $1]

        Sub
          "A" "B"
      """

      assert.deepEqual ["T", []], parse ""
      assert.deepEqual ["T", [["A", "B"]]], parse "AB"
      assert.deepEqual ["T", [["A", "B"], ["A", "B"]]], parse "ABAB"

    it "should work with nested structures", ->
      {parse} := generate """
        Rule
          "A" "B" "C" -> [$2, [$3, [$3, $1]], $1]
      """

      assert.deepEqual ["B", ["C", ["C", "A"]], "A"], parse "ABC"

    it "should work with basic types", ->
      {parse} := generate """
        Rule
          "" -> [true, false, null, undefined, 0xff, 0xFF, 7, "A", []]
      """

      assert.deepEqual [true, false, null, undefined, 0xff, 0xFF, 7, "A", []], parse ""

    it "should handle multi-line arrays", ->
      {parse} := generate """
        Rule
          "" -> [
            [
              1,
              2
            ],
            3
          ]
      """

      assert.deepEqual [[1, 2], 3], parse ""

    it "should allow postfix after multi-line array inline handlers", ->
      {parse} := generate """
        Rule
          "" -> [
            "a",
            "b"
          ].join("")
      """

      assert.equal "ab", parse ""

    it "should map object structures", ->
      {parse} := generate """
        Rule
          "" -> [{}, {a: true}, {b: [0], c: 1}]
      """

      assert.deepEqual [{}, {a: true}, {b: [0], c: 1}], parse ""

    it "should map nested structures", ->
      {parse} := generate """
        Rule
          "a" -> [{b: [{x: 2, y: [{z: -1.3}]}, [{}]], c: 1}]
          "b" -> {b: [{x: 2, y: [{z: -1.3}]}, [{}]], c: 1}
      """

      assert.deepEqual parse("a"), [{b: [{x: 2, y: [{z: -1.3}]}, [{}]], c: 1}]
      assert.deepEqual parse("b"), {b: [{x: 2, y: [{z: -1.3}]}, [{}]], c: 1}

    it "should map object shorthand", ->
      {parse} := generate """
        Rule
          A:a B:b -> {a, b}
        A
          "a" -> 1
        B
          "b" -> 2
      """

      assert.deepEqual parse("ab"), {"a": 1, "b": 2}

    it "should work with multi-line objects", ->
      {parse} := generate """
        Rule
          "a" -> {
            b: [{x: 2, y: [{z: -1.3}]}, [{}]],
            c: 1
          }
      """

      assert.deepEqual {b: [{x: 2, y: [{z: -1.3}]}, [{}]], c: 1}, parse "a"

    it "should allow postfix after multi-line object inline handlers", ->
      {parse} := generate """
        Rule
          "" -> {
            a: 1,
            b: 2
          }.a
      """

      assert.equal 1, parse ""

  describe "$ Prefix Operator: result text", ->
    it "should return the whole text of the match", ->
      {parse} := generate """
        Rule
          $("AAA" "B" "C")
      """

      assert.equal "AAABC", parse "AAABC"

    it "should keep pass through fail states", ->
      {parse} := generate """
        Rule
          $A / $B
        A
          [aA]+
        B
          [bB]+
      """

      assert.equal "aaAaa", parse "aaAaa"
      assert.equal "bBbb", parse "bBbb"
      assert.throws ->
        parse "c"
      , /Expected:\s*A/

    it "should correctly span repetitions", ->
      {parse} := generate """
        Rule
          $("A" "B" "C")*
      """

      assert.equal "ABCABC", parse "ABCABC"
      assert.equal "", parse ""

    it "should handle nested rules", ->
      {parse} := generate """
        RegExpLiteral
          "/" !_ $RegExpCharacter* "/" -> ["R", $3]
          CharacterClassExpression

        CharacterClassExpression
          $CharacterClass+ -> ["R", $1]

        RegExpCharacter
          [^\\/\\\\]+
          EscapeSequence

        CharacterClass
          "[" CharacterClassCharacter* "]" Quantifier?

        CharacterClassCharacter
          [^\\]\\\\]+
          EscapeSequence

        Quantifier
          /[?+*]|\\{\\d+(,\\d+)?\\}/

        EscapeSequence
          Backslash . ->
            return '\\\\' + $2

        Backslash
          "\\\\"

        _
          [ \\t]+
      """

      assert.deepEqual ["R", "[abc][bc]"], parse "[abc][bc]"
      assert.deepEqual ["R", "[^]a\\[\\^b]"], parse "/[^]a\\[\\^b]/"

  it "should work with assertions", ->
    {parse} := generate """
      Rule
        &"B" "C"+
        &"A" "A"+ ->
          return $2
    """

    assert.equal parse("AAAAAA").length, 6

  it "assertions should return true as success value", ->
    {parse} := generate """
      Rule
        &"A":a "A"+ ->
          return $1
    """

    assert.equal parse("AAAAAA"), true

  it "negative assertions should return true as success value", ->
    {parse} := generate """
      Rule
        !"B":a "A"+ ->
          return $1
    """

    assert.equal parse("AAAAAA"), true

  it "optional assertion returns true when present, undefined when not", ->
    {parse} := generate """
      Rule
        (&A)?:b A? "B" ->
          return b

      A
        "A"
    """

    assert.equal parse("AB"), true
    assert.equal parse("B"), undefined

  it "should have string handlers", ->
    {parse} := generate """
      Rule
        "A"+ -> "a"
        "B"+ -> "b"
    """

    assert.equal parse("AAAAAA"), "a"
    assert.equal parse("BBB"), "b"

  describe "starting rules", ->
    it "should be able to parse from any starting rule", ->
      assert hera.parse "[]",
        startRule: "CharacterClassExpression"

    it "should throw an error when a non-existent starting rule is given ", ->
      assert.throws ->
        hera.parse "",
          startRule: "DoesNotExist"
      , /Could not find rule/

  it "should tokenize", ->
    grammar := """
      Rule
        &"D" /D/ -> "d"
        !"C" A+ -> "a"
        "B"+ -> "b"

      A
        "A"

      Wrapped
        "X" -> "wrapped"
    """
    {parse: parseTokens} := generate grammar, { tokenize: true }
    {parse} := generate grammar

    result .= parseTokens("AAAAAA")
    assert.equal result.children[1].length, 6

    result = parseTokens("BBB")
    assert.equal result.children.length, 3

    result = parseTokens("D")
    // TODO: Regex tokenize?
    // assert.deepEqual result.children[1], 1

    // Top-level rule with a handler — tokenize compile must skip the handler
    // and wrap the result in a Token.
    wrapped := parseTokens("X", startRule: "Wrapped")
    assert.equal wrapped.type, "Wrapped"
    assert.equal wrapped.token, "X"
    assert.equal parse("X", startRule: "Wrapped"), "wrapped"

    // tokenize compile shouldn't affect a non-tokenize parser of the same grammar
    assert.equal parse("BBB"), "b"

  it "should expose parseTokens for the bundled hera grammar", ->
    // The lazy-loaded prebuilt tokenize hera parser. Token tree of a tiny
    // grammar must surface the rule names so LSP-style consumers can walk it.
    tokens := parseTokens """
      Rule
        "x"
    """
    assert.equal tokens.type, "Grammar"
    assert.ok tokens.children.length > 0

  it "should skip infinite zero width loops", ->
    {parse} := generate """
      Rule
        ""* "a"
    """

    result := parse("a")
    assert.deepEqual result, [[], "a"]

  it "should throw an error when there is unconsumed input", ->
    {parse} := generate """
      Rule
        "a"
    """

    assert.throws ->
      parse("aa")
    , /Unconsumed input/

  it "reports the line and column of unconsumed input", ->
    {parse} := generate """
      Rule
        "a\\n"* "b"
    """

    assert.throws ->
      parse("a\na\nb\nc", filename: "x.hera")
    , (e: Error) ->
      assert.equal e.message, "x.hera:3:2 Unconsumed input\n\n\nc\n"
      true

  it "reports locations correctly in CRLF input", ->
    {parse} := generate """
      Rule
        "a\\r\\n"* "b"
    """

    // Unconsumed input after a full match: "\r\nc" starts on line 3, column 2
    assert.throws ->
      parse("a\r\na\r\nb\r\nc", filename: "x.hera")
    , (e: Error) ->
      assert.equal e.message, "x.hera:3:2 Unconsumed input\n\n\r\nc\n"
      true

    // Failed expectation: "q" is on line 3, column 1
    assert.throws ->
      parse("a\r\na\r\nq", filename: "x.hera")
    , (e: Error & { line: number, column: number }) ->
      assert.equal e.line, 3
      assert.equal e.column, 1
      true

  it "should throw an error when there are no failed expectations but still input remaining", ->
    {parse} := generate """
      Rule
        ""
    """

    assert.throws ->
      parse("bb")
    , /Unconsumed input/

  it "throws an error when parsing non-strings", ->
    {parse} := generate """
      Rule
        "a"
    """

    assert.throws ->
      parse(undefined as! string)
    , /Input must be a string/

  it "should throw an error when running out of input", ->
    {parse} := generate """
      Rule
        "aaaa"
        EOF
      EOF
        !/[\s\S]/
    """

    assert.throws ->
      parse "aaa"
    , /Rule "aaaa"/

  it "should compile object literal handlers", ->
    rules := hera.parse """
      Rule
        "a" -> {a: [true, "b", $0]}
    """

    assert compile rules

  it "should reuse duplicated regexp literals", ->
    code := compile hera.parse("""
      Rule
        /a+/
        /a+/
    """)

    assert code.includes('const $R0 = $R(')
    assert !code.includes('const $R1 = $R(')

  it "should throw an error when encountering an invalid handler", ->
    rules := hera.parse """
      Rule
        "a"
    """

    rules.Rule[2] = {
      f: 0
    }

    assert.throws ->
      compile(rules)
    , /unknown handler format/

  it "should throw an error when handlers are malformed", ->
    rules := hera.parse """
      Rule
        "a"
    """

    rules.Rule[2] = { yo: "wat" }

    assert.throws ->
      compile(rules)
    , /unknown handler format/

  it "throw an error when encountering an unknown operator", ->
    rules := hera.parse """
      Rule
        "a"
    """

    // Hack in an unknown operator
    rules.Rule[0] = "QQ"

    assert.throws ->
      compile(rules)
    , /QQ/

  it "should error when referencing an unknown rule", ->
    assert.throws ->
      // TODO: throw during compile or even at end of parse?
      {parse} := generate """
        Rule
          "aaaa"
          EOF
      """

      parse "b"
    , /EOF/

  it "should give accurate error message with multiline input", ->
    grammar := """
      Rule
        Line+
      Line
        "aaaa" EOL
      EOL
        /\r\n|\n/
    """
    assert.match compile(parse(grammar)), /\/\\r\\n\|\\n\/suy/
    parser := generate grammar

    assert.throws ->
      parser.parse """
        aaaa
        aaaa
        aaaa
        aaa
      """
    , /4:1/

  it "should annotate errors with meta data", ->
    {parse} := generate """
      Rule
        Line+
      Line
        "aaaa" EOL
      EOL
        /\r\n|\n/
    """

    assert.throws ->
      parse """
        aaaa
        aaaa
        aaaa
        aaa
      """
    , (thrown) ->
      assert.equal thrown.line, 4
      assert.equal thrown.column, 1
      assert.equal thrown.offset, 15
      assert.equal thrown.message, """
        <anonymous>:4:1 Failed to parse
        Expected:
        \tLine "aaaa"
        Found: "aaa"

      """

      return true

  it "should reject a literal ending in a lead surrogate", ->
    // "\uD83D" is the lead half of 😀.  A literal ending in it could match
    // half of the pair and leave the cursor inside it, where a Unicode regex
    // matches from the lead half, before the cursor
    for lit of ["\\uD83D", "a\\uD83D", "\\u{D83D}", "\uDBFF"]
      assert.throws (-> generate `Root\n  "${lit}"`), /ends in a lead surrogate/

  it "should decode escapes before checking for a trailing lead surrogate", ->
    // A line continuation after the lead half leaves it last
    assert.throws (-> generate `Root\n  "\\uD83D\\\n"`), /ends in a lead surrogate/
    for lit of ["\\uD83D\\n", "\\uD83D\\x41", "\\uD83D\\0", "\\uD83D\\101", "\\uD83D\\u{41}", "\\uD83D\\q"]
      generate `Root\n  "${lit}"`

  it "should compile string literals without evaluating code", ->
    // As under CSP or --disallow-code-generation-from-strings
    {Function: OriginalFunction} := globalThis
    globalThis.Function = (-> throw new EvalError "code generation disallowed") as any
    try
      compile 'Root\n  "a\\n"\n'
    finally
      globalThis.Function = OriginalFunction

  it "should allow literals containing whole surrogate pairs", ->
    {parse} := generate """
      Root
        "\\uD83D\\uDE00" "😀" "\\uDE00" -> "ok"
    """
    assert.equal parse("😀😀\uDE00"), "ok"

  it "should match an unpaired lead surrogate with a regex", ->
    // What the error suggests instead: a Unicode regex never splits a pair
    {parse} := generate """
      Root
        /\\uD83D/ /.+/ -> "half"
        /.+/ -> "whole"
    """
    assert.equal parse("😀az"), "whole"
    assert.equal parse("\uD83Daz"), "half"

  it "should skip rules programmatically", ->
    {parse} := generate """
      Rule
        Skipped
        V

      Skipped
        "" ->
          return $skip

      V
        "" -> "ok"
    """

    assert.equal parse(""), "ok"

  describe "named parameters", ->
    it "should provide named parameters for a sequence", ->
      {parse} := generate """
        Rule
          A:a B:b ->
            return [a, b]

        A
          "a"

        B
          "b"
      """

      assert.deepEqual parse("ab"), ["a", "b"]

    it "should emit named parameters directly", ->
      grammar := """
        Rule
          A:a B:b -> a

        A
          "a"

        B
          "b"
      """
      result := compile(parse(grammar), language: 'javascript')
      assert.match result, /\(function\(a\) \{/m
      assert.match result, /\}\)\(\$\$r\.value\[0\]\)/m
      assert.doesNotMatch result, /var a = \$1/

    it "should not void named parameters", ->
      grammar := """
        Rule
          "a":a -> a
      """
      result := compile(parse(grammar), language: 'typescript')
      assert.match result, /\(function\(a: typeof \$\$r\.value\) \{/m
      assert.doesNotMatch result, /void[^;]*a;/

    it "should reject duplicate named parameters", ->
      assert.throws ->
        compile parse """
          Rule
            A:x B:x -> x

          A
            "a"

          B
            "b"
        """
      , /duplicate named parameter: x/

    it "should reject names reserved for positional parameters", ->
      assert.throws ->
        compile parse """
          Rule
            "a":$0 -> $0
        """
      , /Failed to parse/

      assert.throws ->
        compile parse """
          Rule
            "a":$loc -> $loc
        """
      , /Failed to parse/

      assert.throws ->
        compile parse """
          Rule
            "a":$skip -> $skip
        """
      , /Failed to parse/

    it "should provide named parameters for a single string", ->
      {parse} := generate """
        A
          "a":a ->
            return a
      """

      assert.equal parse("a"), "a"

    it "should provide named parameters for a single regexp", ->
      {parse} := generate """
        A
          /a+/:a ->
            return a
      """

      assert.equal parse("aaa"), "aaa"

    it "should provide named parameters for an alias", ->
      {parse} := generate """
        Rule
          A:a ->
            return a

        A
          /a+/:a ->
            return a
      """

      assert.equal parse("aa"), "aa"

    it "should allow named parameters in one-line handlers", ->
      {parse} .= generate """
        A
          "a":a -> [a, a]
      """

      assert.deepEqual parse("a"), ["a", "a"]

      {parse} = generate """
        Rule
          A:a B:b -> [b, a]

        A
          [a]+

        B
          [b]+
      """

      assert.deepEqual parse("abb"), ["bb", "a"]

  describe "events", ->
    it "does not carry events over to a later parse call", ->
      grammar := """
        Rule
          "a"
      """
      typedCode := compile grammar, types: true
      parsers := [
        generate grammar
        execMod transpileTsToJs typedCode, module: typescript.ModuleKind.CommonJS
      ]
      for { parse } of parsers
        calls .= 0
        parse "a", events: { enter: -> calls++; undefined }
        parse "a"
        assert.equal calls, 1

    it "should pass data from enter to exit events", ->
      {parse} := generate """
        Rule
          "a"
      """

      events :=
        enter: (rule, state) ->
          eventLog.push [rule, state]
          return {data: "the data"}
        exit: (rule, state, result, data) ->
          eventLog.push [rule, state, result, data]

      eventLog: unknown[] := []
      parse "a", { events }

      assert.deepEqual eventLog, [
        ["Rule", {
          input: "a",
          pos: 0,
        }]
        ["Rule", {
          input: "a",
          pos: 0,
        }, {
          loc:
            length: 1
            pos: 0
          pos: 1
          value: "a"
        }, "the data"]
      ]

    it "should not emit parent-rule events from typed choice alternatives", ->
      {parse} := generate """
        Rule
          A ::string
          B ::string

        A
          "a"
        B
          "b"
      """

      eventLog: unknown[] := []
      events :=
        enter: (rule, state) ->
          eventLog.push ["enter", rule, state.pos]
          return undefined
        exit: (rule, state, result) ->
          eventLog.push ["exit", rule, state.pos, result?.value]

      assert.equal parse("b", { events }), "b"
      assert.deepEqual eventLog.filter((event) -> event[1] is "Rule"), [
        ["enter", "Rule", 0]
        ["exit", "Rule", 0, "b"]
      ]

  describe "modImport", ->
    it "should generate module", ->
      {parse} := await modImport """
        Rule
          "a"
      """

      assert parse("a")

  describe "CompilerOptions.language", ->
    it "should default to JS scaffold when language is unset", ->
      grammar := """
        Rule
          "a" ->
            return "ok"
      """
      result := compile(parse(grammar))
      // JS scaffold does not contain ParseState type annotation
      assert.doesNotMatch result, /: ParseState/

    it "should use TS scaffold when language is 'typescript'", ->
      grammar := """
        Rule
          "a" ->
            return "ok" as string
      """
      result := compile(parse(grammar), language: 'typescript')
      // TS scaffold contains ParseState type annotation
      assert.match result, /: ParseState/

    it "should use TS scaffold when language is 'civet'", ->
      grammar := """
        Rule
          "a" ->
            return "ok" as string
      """
      result := compile(parse(grammar), language: 'civet')
      assert.match result, /: ParseState/

    it "should write a ternary for skip handlers, which Civet compiles too", ->
      grammar := """
        Rule
          "a" -> $skip
          "a" -> "second"
      """
      result := compile(parse(grammar), language: 'civet')
      assert.match result, / = \(\$\$m as any\) !== SKIP \? /m
      js := civet.compile(result, { sync: true, js: true }) as string
      assert.equal (execMod(js) as any).parse("a"), "second"

    it "should indent inline civet handlers by two spaces", ->
      grammar := """
        Rule
          MaybeNestedTypePrimary:t :: TypeSuffix -> {
            type: "TypeSuffix",
            ts: true,
            t,
          }
      """
      result := compile(parse(grammar), language: 'civet')
      // Handler bodies inside the IIFE are emitted at 4-space so they're
      // strictly deeper than the IIFE's 2-space declaration line (civet
      // uses indent to disambiguate function bodies from object literals).
      // For multi-line inline handlers the continuation lines are shifted
      // by bodyIndent (4 extra spaces) past the grammar's original indent
      // so downstream indent-sensitive parsers read them as the object
      // body rather than separate statements.
      assert.match result, /\(function\(t:/m
      assert.match result, /\n    return \{\n        type: "TypeSuffix",/m
      // The handler IIFE closes with `  })(...)` at 2-space indent.
      assert.match result, /\n  \}\)\(/m

    it "should use CJS require() and not ESM import when language is 'civet' and module is not set", ->
      grammar := """
        Rule
          "a" ->
            return "ok" as string
      """
      result := compile(parse(grammar), language: 'civet')
      assert.match result, /require\(/
      assert.doesNotMatch result, /^import /

    it "should use ESM import when language is 'civet' and module is true", ->
      grammar := """
        Rule
          "a" ->
            return "ok" as string
      """
      result := compile(parse(grammar), language: 'civet', module: true)
      assert.match result, /^import /m
      assert.doesNotMatch result, /require\(/

    it "should use JS scaffold when language is 'javascript'", ->
      grammar := """
        Rule
          "a" ->
            return "ok"
      """
      result := compile(parse(grammar), language: 'javascript')
      assert.doesNotMatch result, /: ParseState/

    it "should respect existing types:true when language is unset", ->
      grammar := """
        Rule
          "a" ->
            return "ok" as string
      """
      result := compile(parse(grammar), types: true)
      assert.match result, /: ParseState/

    it "should emit regex-handler positional args without TS casts in JS mode", ->
      grammar := """
        Rule
          /(\\d+)/ ->
            return $1
      """
      result := compile(parse(grammar), language: 'javascript')
      // Regex handlers emit single positional access directly from
      // `$$r.value`; the `as any[]` cast is TS-only so it must not leak into
      // JS output.
      assert.match result, /\$\$r\.value\[1\]/
      assert.doesNotMatch result, /as any\[\]/

    it "should omit unused handler arguments and cached locals", ->
      grammar := """
        Rule
          "a" ->
            return 1
      """
      result := compile(parse(grammar), language: 'typescript')
      assert.match result, /\(function\(\) \{/m
      assert.match result, /\}\)\(\)/m
      assert.doesNotMatch result, /\$\$value = \$\$r\.value/
      assert.doesNotMatch result, /void[^;]*\$0;/

    it "should not match internal $$ names as handler parameters", ->
      grammar := """
        Rule
          "a" ->
            return $$loc
      """
      result := compile(parse(grammar), language: 'javascript')
      assert.match result, /\(function\(\) \{/m
      assert.match result, /\}\)\(\)/m
      assert.doesNotMatch result, /\(function\(\$loc/
      assert.doesNotMatch result, /\}\)\(\$\$r\.loc\)/

    it "should cache parser value when repeated value arguments are used", ->
      grammar := """
        Rule
          "a" ->
            return [$0, $1]
      """
      result := compile(parse(grammar), language: 'typescript')
      assert.match result, /\(function\(\$0:/m
      assert.match result, /\$\$value = \$\$r\.value/
      assert.match result, /\$\$value = \$\$r\.value;[\s\S]*\}\)\(\$\$value, \$\$value\)/m
      assert.match result, /void \$0, \$1;/

  describe "transpileEmbedded", ->
    civetJsTranspiler := (src: string, upstreamSourceMap?: SourceMap) ->
      civet.compile src, {
        sync: true
        js: true
        filename: "test.hera"
        ...(upstreamSourceMap and { sourceMap: true, upstreamSourceMap })
      } as any

    it "should batch-transpile Civet code blocks, handlers, inline handlers, $skip, and dynamic regexes in a single call", ->
      grammar := """
        ```
        helper := (s: string) -> s.toUpperCase()
        prefix := "x"
        flag := true
        ```

        Start
          SkipCheck
          DynCheck
          BlockCheck
          InlineCheck
          MultiInlineCheck

        SkipCheck
          "skip" ->
            $skip

        DynCheck
          /// p-\${prefix}-\${if flag then "y" else "z"} /// ->
            helper $0

        BlockCheck
          "b" /\\d+/:num ->
            n := Number(num)
            n * 2

        InlineCheck
          "i" -> helper "inline"

        MultiInlineCheck
          "m" -> {
            kind: "multi"
            val: helper $1
          }
      """

      calls .= 0
      js := compile grammar, {
        language: 'civet'
        transpileEmbedded: (src, upstreamSM) ->
          calls++
          civetJsTranspiler src, upstreamSM
      }

      assert.equal calls, 1
      // Handlers are never inlined or IIFE-wrapped: the parser calls each
      // handler's transpiled named function, and dynamic regexes call theirs
      assert.doesNotMatch js, /\(function\(/
      assert.match js, /const \$\$m = __hera_h_\d+__\(/
      assert.match js, /__hera_rd_\d+__\(\)/
      assert.match js, /function __hera_h_\d+__\(/

      parser := execMod(js) as any
      assert.throws -> parser.parse("skip")
      assert.equal parser.parse("p-x-y"), "P-X-Y"
      assert.equal parser.parse("b21"), 42
      assert.equal parser.parse("i"), "INLINE"
      assert.deepEqual parser.parse("m"), { kind: "multi", val: "M" }

    it "should support explicit types: true with transpileEmbedded", ->
      grammar := """
        Rule :: string
          "a" ->
            x: string := $1
            x
      """
      ts := compile grammar, {
        language: 'civet'
        types: true
        transpileEmbedded: (src) ->
          civet.compile(src, { sync: true }) as string
      }
      assert.match ts, /: MaybeResult<string>/
      assert.match ts, /const x: string = \$1/

    it "should skip calling transpileEmbedded when grammar has no embedded user code", ->
      grammar := """
        Rule
          "a" "b"
      """
      calls .= 0
      js := compile grammar, {
        language: 'civet'
        transpileEmbedded: (src) ->
          calls++
          src
      }
      assert.equal calls, 0
      parser := execMod(js) as any
      assert.deepEqual parser.parse("ab"), ["a", "b"]

      // Also works with hand-crafted HeraRules lacking Symbol.for("code")
      handCrafted := compile { Rule: ["L", "a"] }, {
        transpileEmbedded: (src) ->
          calls++
          src
      }
      assert.equal calls, 0
      assert.equal (execMod(handCrafted) as any).parse("a"), "a"

    it "should handle grammar with only a fenced code block and no handlers", ->
      grammar := """
        ```
        exports.answer = 42
        ```
        Rule
          "a"
      """
      js := compile grammar, {
        language: 'civet'
        transpileEmbedded: (src) -> civetJsTranspiler src
      }
      mod := execMod(js) as any
      assert.equal mod.answer, 42
      assert.equal mod.parse("a"), "a"

    it "should handle single-line stub output, object without sourceMap, and data.lines sourceMap", ->
      grammar := """
        Rule
          "a" -> $1
      """
      // Plain string with sourceMap: true (falls back to unmapped updateSourceMap)
      plainRes := compile parse(grammar), {
        source: grammar
        filename: "plain.hera"
        sourceMap: true
        transpileEmbedded: (src) -> src
      }
      assert.equal (execMod(plainRes.code) as any).parse("a"), "a"

      // Object without sourceMap + single-line stub output + trailing blank lines
      objRes := compile grammar, {
        transpileEmbedded: (_src) ->
          code: "function __hera_h_0__($1) { return $1.toUpperCase() }\n\n"
      }
      assert.equal (execMod(objRes) as any).parse("a"), "A"

      // Transpiled functions may contain arbitrary statements; they are called, not extracted
      multiStmtRd := compile """
        Rule
          /// \${val()} /// -> $0
      """, {
        transpileEmbedded: (_src) ->
          """
          function __hera_h_0__($0) {
            return $0
          }
          function __hera_rd_0__() {
            const pat = "ok";
            return pat;
          }
          """
      }
      assert.equal (execMod(multiStmtRd) as any).parse("ok"), "ok"

      // Object with a sourceMap while no source map was requested: map is ignored
      unmappedRes := compile grammar, {
        transpileEmbedded: (src) -> { code: src, sourceMap: { lines: [] } }
      }
      assert.equal (execMod(unmappedRes) as any).parse("a"), "a"

      // Object with sourceMap.data.lines
      dataLinesRes := compile parse(grammar), {
        source: grammar
        filename: "data-lines.hera"
        sourceMap: true
        transpileEmbedded: (src, upstreamSM) ->
          compiled := civetJsTranspiler src, upstreamSM
          { code: compiled.code, sourceMap: { data: { lines: compiled.sourceMap.lines } } }
      }
      assert.equal (execMod(dataLinesRes.code) as any).parse("a"), "a"
      assert dataLinesRes.sourceMap.lines.some (line) ->
        line.some (entry) -> entry.length is 4 and entry[2] is 1

    it "should pass one virtual module of code blocks plus named handler and regex functions", ->
      grammar := """
        ```
        const k = 1
        ```
        Rule
          "a" -> $1 + k
        Block
          "b" ->
            return $0
        Dyn
          /// \${"c"} ///
      """
      let seen = ""
      js := compile grammar, {
        transpileEmbedded: (src) ->
          seen = src
          src
      }
      // Code blocks come first, then one named function per handler / interpolation
      assert.match seen, /^\nconst k = 1\n/
      assert.match seen, /function __hera_h_0__\(\$1\) \{\n    return \$1 \+ k\n\}/
      assert.match seen, /function __hera_h_1__\(\$0\) \{\n    return \$0\n\}/
      assert.match seen, /function __hera_rd_0__\(\) \{\n  return \("c"\)\n\}/
      mod := execMod(js) as any
      assert.equal mod.parse("a"), "a1"
      assert.equal mod.parse("b", { startRule: "Block" }), "b"
      assert.equal mod.parse("c", { startRule: "Dyn" }), "c"

      // Typed handler functions take their parameter types from the rule's
      // top-level parser, `void` unused $-params, and keep the declared return type
      let typedSeen = ""
      compile """
        Rule
          "a" "b" :: string ->
            return $2
      """, {
        types: true
        transpileEmbedded: (src) ->
          typedSeen = src
          src
      }
      assert.match typedSeen, /function __hera_h_0__\(\$2: Unwrap<ReturnType<typeof Rule\$parser>>\[1\]\):\s*string\s*\{\n    void \$2;\n/

      // A transpiler that drops a handler function yields a parser that fails loudly at parse time
      broken := execMod(compile(grammar, { transpileEmbedded: -> "const k = 1" })) as any
      assert.throws (-> broken.parse("a")), /__hera_h_0__ is not defined/

    it "should keep heregex interpolations' values and identifier reads", ->
      grammar := """
        ```
        let shared = "a"
        let dynamic = ""
        exports.setShared = (s) => { shared = s }
        ```
        Rule
          /// ${const shared}${dynamic} ///
        Multiline
          /// ${
            "m" + "l"
          } ///
      """
      for transpileEmbedded of [undefined, ((src: string) -> src)]
        mod := execMod(compile grammar, { transpileEmbedded }) as any
        assert.equal mod.parse("ml", { startRule: "Multiline" }), "ml"
        // An identifier `const` part is read directly, not cached
        assert.equal mod.parse("a"), "a"
        mod.setShared "b"
        assert.equal mod.parse("b"), "b"

      // The same through Civet
      civetMod := execMod(compile grammar, {
        language: 'civet'
        transpileEmbedded: (src) -> civetJsTranspiler src
      }) as any
      assert.equal civetMod.parse("ml", { startRule: "Multiline" }), "ml"
      civetMod.setShared "c"
      assert.equal civetMod.parse("c"), "c"

    // tsc drops an import it sees no use of, and CommonJS output renames one
    it "should read a heregex interpolation's binding inside the transpiled module", ->
      grammar := """
        ```
        import { EOL } from "node:os"
        ```
        Rule
          /// ${EOL} /// -> $0
      """
      js := compile grammar, transpileEmbedded: (src) ->
        transpileTsEmbedded src, { module: typescript.ModuleKind.CommonJS }
      assert.equal (execMod(js) as any).parse(EOL), EOL

    it "should map each rule's generated code to the rule, and its handler's to the alternative", ->
      grammar := """
        Rule ::number
          "a" Num ->
            return $2.value

        Num
          /\\d+/ -> { value: 1 }

        Bare
          "b"
      """
      { code, sourceMap } := compile parse(grammar), {
        source: grammar
        filename: "anchored.hera"
        language: 'civet'
        types: true
        sourceMap: true
        transpileEmbedded: (src, upstreamSM) ->
          civet.compile src, { sync: true, sourceMap: true, upstreamSourceMap: upstreamSM, filename: "anchored.hera" } as any
      }
      outLines := code.split "\n"
      sources := (match: string) ->
        i := outLines.findIndex .includes match
        assert i >= 0, match
        sourceMap.lines[i].filter((e) -> e.length is 4).map (e) -> [e[2], e[3]]

      // Rule's header maps to the rule, with a segment at each identifier so
      // that a consumer that interpolates columns stays on the rule's
      // position, except for its type, copied from the `::number`
      header := sources "function Rule("
      assert header.length > 5
      assert.deepEqual new Set(header.map(JSON.stringify)), new Set [[0, 0], [0, 7]].map(JSON.stringify)
      // The handler's function maps to its alternative's line, through the
      // transpiler's map, except for its return type, copied from the rule's
      // `::number`
      handlerHeader := sources "function __hera_h_0__("
      assert handlerHeader.length > 0
      assert handlerHeader.every ([line, column]) -> line is 1 or (line is 0 and column is 7)
      assert handlerHeader.some ([line]) -> line is 0
      // So does a rule without a handler
      assert.deepEqual new Set(sources("function Bare(").map(JSON.stringify)), new Set [JSON.stringify [7, 0]]

    it "should compose accurate source maps back to original .hera lines", ->
      grammar := """
        ```
        tag := (s) -> `[${s}]`
        ```

        Rule
          "a" ->
            val := tag $1
            val
      """
      { code, sourceMap } := compile parse(grammar), {
        source: grammar
        filename: "mapped.hera"
        language: 'civet'
        sourceMap: true
        transpileEmbedded: (src, upstreamSM) -> civetJsTranspiler src, upstreamSM
      }

      parser := execMod(code) as any
      assert.equal parser.parse("a"), "[a]"

      // Find the line in generated output containing `const val = tag($1)`
      outLines := code.split "\n"
      valLineIdx := outLines.findIndex (l) -> l.includes "const val = tag($1)"
      assert valLineIdx >= 0, "expected compiled handler line"
      // Original `    val := tag $1` is at 0-based line 6 in `grammar`
      entries := sourceMap.lines[valLineIdx]
      assert entries.some (e) -> e.length is 4 and e[2] is 6

      // Also verify inlineMap embeds valid base64 source map
      inlineCode := compile grammar, {
        filename: "mapped.hera"
        language: 'civet'
        inlineMap: true
        transpileEmbedded: (src, upstreamSM) -> civetJsTranspiler src, upstreamSM
      }
      assert.match inlineCode, /sourceMappingURL=data:application\/json;base64,/

    it "should splice mid-line and empty entries cleanly in SourceMap.appendMapped", ->
      sm := new SourceMap("line0\nline1\n", "test.hera")
      sm.updateSourceMap "prefix"
      // Mid-line append with 4-tuple first entry, followed by 1-tuple line, followed by empty line
      sm.appendMapped "abc\ndef\nghi", [
        [[0, 0, 1, 2], [2, 0, 1, 4]]
        [[1]]
        []
      ]
      // First line had colOffset=6 ("prefix"), so first entry colDelta becomes 6
      assert.deepEqual sm.lines[0], [[6, 0, 1, 2], [2, 0, 1, 4]]
      // Second line started at colOffset=0
      assert.deepEqual sm.lines[1], [[1]]
      // Third line had no mapped entries, colOffset advanced by "ghi".length
      assert.deepEqual sm.lines[2], []
      assert.equal sm.colOffset, 3

      // Mid-line append whose first entry is a 1-tuple
      sm.appendMapped "jk", [[[1]]]
      assert.deepEqual sm.lines[2], [[4]]
      assert.equal sm.colOffset, 1

    it "should preserve outer terminal and handler definitions across nested compile() calls", ->
      outerGrammar := """
        ```
        tag := "outer"
        ```
        Outer
          "hello" /\\d+/ /// -\${tag} /// ->
            `\${tag}:\${$1}:\${$2[0]}`
      """
      innerGrammar := """
        Inner
          "world" /[a-z]+/ ->
            $2[0].toUpperCase()
      """

      let innerParser: any
      outerJs := compile outerGrammar, {
        language: 'civet'
        transpileEmbedded: (src, upstreamSM) ->
          // Re-enter Hera compile() with a completely different grammar
          innerJs := compile innerGrammar, {
            language: 'civet'
            transpileEmbedded: (s, sm) -> civetJsTranspiler s, sm
          }
          innerParser = execMod innerJs
          civetJsTranspiler src, upstreamSM
      }

      outerParser := execMod(outerJs) as any
      assert.equal innerParser.parse("worldabc"), "ABC"
      assert.equal outerParser.parse("hello42-outer"), "outer:hello:42"

    it "should ignore trailing sourceMappingURL comments from transpileEmbedded", ->
      grammar := """
        Root
          "a" -> 1
      """
      // External sourceMappingURL comment (e.g. from tsc)
      jsExternal := compile grammar, {
        transpileEmbedded: (src) -> `${src}\n//# sourceMappingURL=out.js.map\n`
      }
      assert.equal (execMod(jsExternal) as any).parse("a"), 1

      // Civet with inlineMap: true returning trailing base64 sourceMappingURL
      jsInline := compile grammar, {
        language: 'civet'
        transpileEmbedded: (src) ->
          civet.compile(src, { sync: true, js: true, inlineMap: true, filename: "t.hera" }) as string
      }
      assert.equal (execMod(jsInline) as any).parse("a"), 1

      // esbuild, minifying, with an inline map
      jsMinified := compile grammar, {
        transpileEmbedded: (src) -> esbuild.transformSync(src, { loader: "ts", minify: true, sourcemap: "inline" }).code
      }
      assert.equal (execMod(jsMinified) as any).parse("a"), 1
      assert !jsMinified.includes "sourceMappingURL"

      // The same text in user code is kept, even as the last line a minifier
      // leaves: a line that ends a string, template literal or block comment
      // holds what closes it
      userCode := [
        ['exports.literal = "x//# sourceMappingURL=y"', "x//# sourceMappingURL=y"]
        ["exports.literal = `\n//# sourceMappingURL=y`", "\n//# sourceMappingURL=y"]
        ['exports.literal = "x\\\n//# sourceMappingURL=y"', "x//# sourceMappingURL=y"]
        ["exports.literal = 1\n/*\n//# sourceMappingURL=y*/", 1]
      ]
      transpilers := [
        (src: string) -> src
        (src: string) -> civet.compile(src, { sync: true, js: true }) as string
        (src: string) -> esbuild.transformSync(src, { minifySyntax: true }).code
        (src: string) -> esbuild.transformSync(src, { minify: true }).code
      ]
      for [code, literal] of userCode
        for transpileEmbedded of transpilers
          js := compile `\`\`\`\n${code}\n\`\`\`\nRoot\n  "a"\n`, { language: 'civet', transpileEmbedded }
          assert.equal (execMod(js) as any).literal, literal, code

    it "should avoid name collisions when user code uses the __hera_ prefix (including unicode escapes)", ->
      grammar := """
        ```
        function __hera_h_0__() { return 40 }
        function getValue() { return __hera_h_0__() + 2 }
        ```
        Root
          "a" -> getValue()
      """
      js := compile grammar, {
        language: 'civet'
        transpileEmbedded: (src, upstreamSM) -> civetJsTranspiler src, upstreamSM
      }
      assert.match js, /__hera__h_0__\(/
      assert.equal (execMod(js) as any).parse("a"), 42

      // Transpiler normalizing unicode escapes (\u005f / \u{5f}) to underscores
      escapedGrammar := """
        ```
        function \\u005f_hera_h_0__() { return 40 }
        function \\u{5f}_hera__h_0__() { return 0 }
        function getValue() { return __hera_h_0__() + __hera__h_0__() + 2 }
        ```
        Root
          "a" -> getValue()
      """
      escapedJs := compile escapedGrammar, {
        transpileEmbedded: (src) -> esbuild.transformSync(src).code
      }
      assert.match escapedJs, /__hera___h_0__\(/
      assert.equal (execMod(escapedJs) as any).parse("a"), 42

    it "should work with compact/minified single-line transpiler output", ->
      grammar := """
        ```
        function getPrefix() { return "ok" }
        ```
        Root
          /// \${"a"} /// -> getPrefix() + ":" + $0
      """
      minifiedJs := compile grammar, {
        transpileEmbedded: (src) -> esbuild.transformSync(src, { minify: true }).code
      }
      assert.equal (execMod(minifiedJs) as any).parse("a"), "ok:a"
