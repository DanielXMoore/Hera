Mini
  Block
  Num

Block
  "{" Num "}" -> {
    type: "Block" as const,
    children: $0,
  }

Num
  /[0-9]+/ -> {
    type: "Num" as const,
    value: parseInt($1),
    children: [$1],
  }

LongChoice
  ( "a" / "b" / "c" / "d" / "e" / "f" / "g" / "h" / "i" / "j" ):letter -> letter

LongSequence
  "a" "b" "c" "d" "e" "f" "g" "h" "i" "j" "k"
