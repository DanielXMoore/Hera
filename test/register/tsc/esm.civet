assert from assert
{ execMod } from ../../../source/main.civet
{ initialize, load } from ../../../source/register/tsc/esm.civet
{ initialize: initializeBase } from ../../../source/esm.civet
{ assertComposedMap, composeFixture } from ../../helper.civet

describe "TypeScript ESM hook", ->
  // The base hook's options apply here too, so start from its defaults
  beforeEach -> initializeBase {}

  grammar := """
    Rule
      "a" ->
        const x: string = "ok"
        return x
  """

  // Its import only resolves with rewriteRelativeImportExtensions
  importing := """
    ```
    import { value } from './helper.ts'
    ```

    Rule
      "a" -> value
  """

  run := (url: string, source = grammar) ->
    calls: { url: string, context: any }[] := []
    next := (url: string, context: any) ->
      calls.push { url, context }
      { source, format: context.format }
    result := await (load as any) url, { format: undefined }, next
    { calls, result }

  it "should compile a grammar's source, passing only its embedded code to tsc", ->
    initialize { hera: { module: false } }
    { calls, result } := await run "file:///tmp/grammar.hera"

    // The source is loaded under a URL that other Hera hooks pass through
    assert.equal calls.length, 1
    assert.equal calls[0].url, "file:///tmp/grammar.hera#hera-tsc-esm-source"
    assert.equal calls[0].context.format, "module"

    assert.equal result.format, "commonjs"
    assert.equal result.shortCircuit, true
    assert.match result.source, /function __hera_h_0__\(\) \{/
    assert.doesNotMatch result.source, /: string/
    assert.equal (execMod(result.source) as any).parse("a"), "ok"

  it "should emit ESM by default and accept tsc options as `data` directly", ->
    initialize { rewriteRelativeImportExtensions: true }
    { result } := await run "file:///tmp/grammar.hera", importing
    assert.equal result.format, "module"
    assert.match result.source, /from "\.\/helper\.js"/

  it "should accept tsc options under `tsc`", ->
    initialize { tsc: { rewriteRelativeImportExtensions: true } }
    { result } := await run "file:///tmp/grammar.hera", importing
    assert.match result.source, /from "\.\/helper\.js"/

  it "should apply the options the base hook was registered with, under its own", ->
    initializeBase { module: false, tokenize: true }
    initialize { hera: { tokenize: false } }
    { result } := await run "file:///tmp/grammar.hera"
    assert.equal result.format, "commonjs"
    assert.equal (execMod(result.source) as any).parse("a"), "ok"

  it "should map the parser back to the .hera source", ->
    initialize { hera: { module: false } }
    { result } := await run `file:///tmp/${composeFixture.filename}`, composeFixture.grammar
    assertComposedMap result.source, `/tmp/${composeFixture.filename}`

  it "should report being registered twice", ->
    initialize()
    await assert.rejects (load as any)("file:///tmp/grammar.hera#hera-tsc-esm-source", {}, ->), /already been registered/

  it "should pass other URLs on unchanged", ->
    initialize()
    context := { format: "module" }
    passed := { source: "export default 1", format: "module" }
    result := await (load as any) "file:///tmp/a.js", context, (url: string, ctx: any) ->
      assert.equal url, "file:///tmp/a.js"
      assert.equal ctx, context
      passed
    assert.equal result, passed
