// ESM hook: Hera compile with transpileEmbedded (only the grammar's embedded
// TypeScript goes through tsc), like the CJS hook

assert from node:assert
{ fileURLToPath } from node:url
type { LoadHook } from node:module

type { CompilerOptions as HeraCompilerOptions } from ../../compiler.civet
{ compile: heraCompile } from ../../main.civet
{ type CompilerOptions, transpileTsEmbedded } from ./transpile.civet

{ registeredOptions } from ../../esm.civet
export { resolve } from ../../esm.civet

// Appended to the URL when loading the grammar's source.  Other Hera hooks
// only handle URLs that end in `.hera`, so one registered further down the
// chain (as the base `register/esm` hook used to be) passes the source
// through instead of compiling it first.  A second copy of this hook raises
// an error for it instead, as the base hook does for its own tag.
sourceTag := '#hera-tsc-esm-source'

export type TscLoaderOptions = {
  hera?: HeraCompilerOptions
  tsc?: CompilerOptions
}

// module-level state set via initialize()
let heraOptions: HeraCompilerOptions = {}
let tscOptions: CompilerOptions = {}

/**
`data` is `{ hera?, tsc? }`: options for the Hera and TypeScript compilers.
TypeScript compiler options passed directly as `data` are also accepted, the
form this hook took when it post-processed the base `register/esm` hook's
output.
*/
export function initialize(data: TscLoaderOptions | CompilerOptions = {})
  if "hera" in data or "tsc" in data
    { hera = {}, tsc = {} } := data as TscLoaderOptions
    heraOptions = hera
    tscOptions = tsc
  else
    heraOptions = {}
    tscOptions = data as CompilerOptions

export load: LoadHook := async (url, context, next) =>
  if url.endsWith sourceTag
    throw new Error """
      The Hera TypeScript ESM loader has already been registered. Use --import instead of -r/--require.
      If you require an ESM module (which this is) with -r/--require it gets loaded twice.
    """

  return next(url, context) unless /\.hera$/.test(url)

  // Without format 'module', Node.js would take the .hera file for JavaScript
  // and try to compile it as a CJS module.
  { source: heraSource } := await next `${url}${sourceTag}`, { ...context, format: 'module' }
  assert heraSource, `${url} file source was not loaded`

  filename := fileURLToPath url
  // A chain set up the old way registered the base `register/esm` hook, in
  // the same thread, with the Hera options
  options: HeraCompilerOptions := { module: true, ...registeredOptions(), ...heraOptions }
  source := heraCompile heraSource.toString(), {
    inlineMap: true
    filename
    transpileEmbedded: (src, upstreamSourceMap) =>
      transpileTsEmbedded(src, tscOptions, upstreamSourceMap)
    ...options
    // Hera writes the parser itself as JavaScript; only the grammar's
    // embedded code goes through tsc
    language: 'javascript'
    types: false
  }

  {
    source
    format: options.module ? "module" : "commonjs"
    shortCircuit: true
  }
