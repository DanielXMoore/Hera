```
import type {
  HeraAST,
  SequenceNode,
  NameNode,
  Handler,
  CodeBlockNode,
} from './hera-types'

const heregexEscapes: Record<string, string> = { "\n": "\\n", "\r": "\\r", " ": " " }
```

Grammar
  Statement* ->
    const code = $1.filter(a => typeof a === "object" && a !== null && "type" in a && a.type === "CodeBlock")
    const rules = Object.fromEntries($1.filter(a => Array.isArray(a)))
    rules[Symbol.for("code")] = code
    return rules

Statement
  EOS? CodeBlock -> $2
  EOS? Rule -> $2

CodeBlock
  TripleBacktick CodeBody TripleBacktick -> $2

Rule
  Name RuleBody -> [$1, $2]

RuleTypeAnnotation
  Space* TypeAnnotation -> $2

RuleBody
  RuleTypeAnnotation?:t EOS ( Indent Choice )+:choices :: HeraAST ->
    var r: HeraAST[] = choices.map((a) => a[1] as HeraAST)
    if (t) r = r.map((a): HeraAST => {
      if (typeof a === "string") return ["S", [a], { t }] as unknown as HeraAST
      const handler = a[2]
      if (handler) {
        if ("t" in handler) return a
        return [a[0], a[1], { ...handler, t }] as unknown as HeraAST
      }
      return [a[0], a[1], { t }] as unknown as HeraAST
    })
    if (r.length === 1) return r[0];
    return ["/", r] as HeraAST

Choice
  Sequence Handling ->
    if ($2 !== undefined) {
      if (!$1.push)
        $1 = ["S", [$1], $2]
      else
        $1.push($2)
    }
    return $1

Sequence
  Expression SequenceExpression+ :: SequenceNode ->
    $2.unshift($1)
    return ["S", $2]
  Expression ChoiceExpression+ :: SequenceNode ->
    $2.unshift($1)
    return ["/", $2]
  Expression

SequenceExpression
  Space Expression -> $2

ChoiceExpression
  Space "/" Space Expression -> $4

ParameterName
  ":" Name -> $2

Expression
  PrefixOperator? Suffix ParameterName? :: SequenceNode | NameNode ->
    var result = null
    if ($1) result = [$1, $2]
    else result = $2
    if ($3)
      return [{name: $3}, result] as NameNode
    return result as SequenceNode

PrefixOperator
  [$&!]

Suffix
  Primary SuffixOperator? ->
    if ($2) return [$2, $1]
    else return $1

SuffixOperator
  [+?*]

Primary
  Name
  Literal
  OpenParenthesis Sequence CloseParenthesis -> $2

Literal
  StringLiteral
  RegExpLiteral

Handling
  EOS ->
    return undefined
  Space* TypeAnnotation?:t Arrow HandlingExpression:handler ->
    if (t) handler = { ...handler, t }
    return handler as Handler
  # Type annotation without a handler: declares the rule's return type
  # while leaving the sub-parser's result to flow through verbatim.
  Space* TypeAnnotation:t EOS ->
    return { t } as Handler

HandlingExpression
  # Try to parse properly indented first — permits a trailing `#` comment on
  # the same line as `->` before the indented block body.
  TrailingCommentEOS HandlingExpressionBody EOS? -> $2
  # Otherwise, allow content on the same line
  HandlingExpressionInline :: Handler ->
    return {
      f: $1.trimEnd(),
      $loc,
      inline: true,
    }

HandlingExpressionBody
  HandlingExpressionLine+ :: Handler ->
    return {
      f: $1.join("").trimEnd(),
      $loc,
    }

HandlingExpressionLine
  $( Indent Indent [^\n\r]* NonCommentEOS )

# Handler that starts with some content on the same line as the arrow
HandlingExpressionInline
  # Require some non-space content on the first line,
  # then take all doubly indented lines, then allow a single-indented finale,
  # then allow normal Hera comments/blank lines after the inline handler.
  $( /[ \t]*\S[^\n\r]*/ NonCommentEOS ) HandlingExpressionLine* HandlingExpressionInlineFinale? EOS? :: string ->
    return $1 + $2.join("") + ($3 ?? "")

# Inline content allows closing bracket on single-indented line to allow e.g.:
#   ... -> [
#     ...double indented...
#   ].join(",")
HandlingExpressionInlineFinale
  $( Indent [\]\}\)][^\n\r]* NonCommentEOS )

StringValue
  "\"" $DoubleStringCharacter* "\"" -> $2

DoubleStringCharacter
  [^"\\]+
  EscapeSequence

EscapeSequence
  $( Backslash . )

StringLiteral
  StringValue -> ["L", $1]

RegExpLiteral
  TripleSlash HeregexBody:body TripleSlash ->
    // Static heregexes use the normal RegExp path; only interpolated ones need RD.
    if (body.every((part) => typeof part === "string"))
      return ["R", body.join("")]
    return ["RD", body]
  "/" !Space $RegExpCharacter* "/" -> ["R", $3]
  $CharacterClassExpression -> ["R", $1]
  "." -> ["R", $1]

HeregexBody
  !TripleSlash HeregexPart* -> $2

HeregexPart
  $CharacterClass -> $1
  "${" Space* "const" Space $HeregexSubstitutionCharacter*:expression "}" -> { expression, constant: true }
  "${" $HeregexSubstitutionCharacter*:expression "}" -> { expression }
  /(?:\\.)/ -> heregexEscapes[$0[1]] ?? $0
  /\/\/(?!\/)[^\n\r]*/ -> ""
  [\s]+ -> ""
  /\/(?!\/\/)/ -> "\\/"
  /[^[\/\s#$\\]+|[#$]/ -> $0

HeregexSubstitutionCharacter
  [^}\\]+
  EscapeSequence

CharacterClassExpression
  CharacterClass+

RegExpCharacter
  [^\/\\]+
  EscapeSequence

CharacterClass
  "[" CharacterClassCharacter* "]" Quantifier?

CharacterClassCharacter
  [^\]\\]+
  EscapeSequence

Quantifier
  /[?+*]|\{\d+(,\d+)?\}/

Name
  [_a-zA-Z][_a-zA-Z0-9]*

Arrow
  "->" Space*

Backslash
  "\\"

TripleSlash
  "///"

OpenBrace
  /\{\s*/

CloseBrace
  /\}[ \t]*/

OpenBracket
  /\[\s*/

CloseBracket
  /\][ \t]*/

OpenParenthesis
  /\([ \t]*/

CloseParenthesis
  /[ \t]*\)/

Indent
  "  "

Space
  [ \t]+

NonCommentEOS
  /([ \t]*(\n|\r\n|\r|$))+/

# Like NonCommentEOS but also accepts a single `#` comment on the first line
# before the newline.  Used after `->` so a trailing comment doesn't get
# mistaken for an inline handler body.
TrailingCommentEOS
  /[ \t]*(#[^\n\r]*)?(\n|\r\n|\r|$)([ \t]*(\n|\r\n|\r|$))*/

EOS
  /([ \t]*(#[^\n\r]*)?(\n|\r\n|\r|$))+/

TripleBacktick
  "```"

TypeAnnotation
  # Match a single-line TS type expression: stop at end-of-line OR at `->`
  # (whichever comes first).  Without the `[^\n\r]` guard this would greedily
  # span subsequent rules thanks to the `s` regex flag applied by the runtime.
  "::" $/(?:(?!->)[^\n\r])*/ -> $2

CodeBody
  $/(?:(?:`(?!``))|[^`])*/ :: CodeBlockNode ->
    return {
      type: "CodeBlock",
      token: $0,
      $loc,
    }
