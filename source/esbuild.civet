{ readFile } from node:fs/promises
{ relative } from node:path
{ compile } from ./main.civet
type { CompilerOptions } from ./compiler.civet
{ civetNotInstalledError } from ./register/civet/transpile.civet
type { Plugin, Loader } from esbuild

export interface HeraPluginOptions < CompilerOptions
  loader?: Loader

export runtime =
  loadCivet: =>
    (await import('@danielx/civet')).default

// Derive the default esbuild loader from the language option.
// An explicit loader option always wins.
defaultLoaderForLanguage := (language: CompilerOptions['language']): Loader =>
  switch language
    when 'typescript', 'civet'
      'ts'
    else
      'js'

export default function heraPlugin({ loader, ...heraOptions }: HeraPluginOptions = {}): Plugin
  name: 'hera'
  setup: (build) =>
    build.onLoad { filter: /.\.hera$/ }, ({ path }) =>
      filename := relative(process.cwd(), path)
      compileOptions: CompilerOptions := { ...heraOptions, filename }

      if heraOptions.language is 'civet' and not heraOptions.transpileEmbedded
        let civet: any
        try
          civet = await runtime.loadCivet()
        catch
          throw civetNotInstalledError()

        // Batch-transpile only the embedded Civet user code (fenced blocks,
        // handler bodies, dynamic regex expressions) to TypeScript, then let
        // esbuild strip types with loader:'ts'.  This preserves advanced TS
        // features (const enum etc.) that Civet can't compile to JS itself,
        // while avoiding re-parsing Hera's generated JS scaffolding through Civet.
        compileOptions.transpileEmbedded = (src, upstreamSourceMap) =>
          civet.compile(src, {
            sync: true
            filename
            ...(upstreamSourceMap and { sourceMap: true, upstreamSourceMap })
          })

      contents := readFile(path, 'utf8')
        |> await
        |> compile ., compileOptions

      resolvedLoader := loader ?? defaultLoaderForLanguage(heraOptions.language)

      { contents, loader: resolvedLoader }
