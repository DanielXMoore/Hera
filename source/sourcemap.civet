// Minimal source map generator, adapted from @danielx/civet's sourcemap.civet.
//
// Only the pieces Hera needs are kept: appending output while tracking the
// source position and rendering a v3 JSON map (the compiler), plus decoding
// and composing mappings (the tsc register hooks, whose `transpileEmbedded`
// composes tsc's map with Hera's).  Vendoring this
// instead of importing it from Civet keeps the whole Civet compiler out of
// the `dist/main.js` bundle, and composing here instead of with a library
// keeps Hera free of runtime dependencies.

/** A mapping entry: [colDelta] or [colDelta, sourceIndex, srcLine, srcCol]. */
export type SourceMapEntry = [number] | [number, number, number, number]

export type SourceMapJSON = {
  version: 3
  file: string
  sources: string[]
  mappings: string
  names: string[]
  sourcesContent: string[]
}

EOL := /\r?\n|\r/
BASE64_CHARS := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
VLQ_SHIFT := 5
VLQ_CONTINUATION_BIT := 1 << VLQ_SHIFT
VLQ_VALUE_MASK := VLQ_CONTINUATION_BIT - 1

/**
Table of end offsets (exclusive) for each line of `input`, used to convert a
position into line/column.
*/
locationTable := (input: string): number[] ->
  linesRe := /([^\r\n]*)(\r\n|\r|\n|$)/y
  lines: number[] := []
  pos .= 0

  while match := linesRe.exec input
    pos += match[0].length
    lines.push pos
    break if pos is input.length

  lines

lookupLineColumn := (table: number[], pos: number): [number, number] ->
  line .= 0
  prevEnd .= 0
  while table[line] <= pos
    prevEnd = table[line++]
  [line, pos - prevEnd]

encodeVlq := (value: number): string ->
  signBit := value < 0 ? 1 : 0
  valueToEncode .= (Math.abs(value) << 1) + signBit
  answer .= ""

  while valueToEncode or !answer
    nextChunk .= valueToEncode & VLQ_VALUE_MASK
    valueToEncode >>= VLQ_SHIFT
    nextChunk |= VLQ_CONTINUATION_BIT if valueToEncode
    answer += BASE64_CHARS[nextChunk]

  answer

/**
Decode a v3 `mappings` string into mapping lines, the inverse of
`SourceMap.renderMappings`.  A segment's name index is dropped.  Throws on
malformed input.
*/
export decodeMappings := (mappings: string): SourceMapEntry[][] ->
  // Built per call rather than at module level so bundles that never decode
  // (dist/main.js) can tree-shake them.
  COMMA := ",".charCodeAt 0
  SEMICOLON := ";".charCodeAt 0
  base64Values := new Int8Array(128).fill -1
  for i of [0...BASE64_CHARS.length]
    base64Values[BASE64_CHARS.charCodeAt i] = i

  current: SourceMapEntry[] .= []
  lines: SourceMapEntry[][] := [current]
  // Fields decoded so far in the current segment.  The source fields are
  // deltas from the previous segment's, so they accumulate as they arrive.
  fieldCount .= 0
  colDelta .= 0
  sourceIndex .= 0
  srcLine .= 0
  srcCol .= 0
  value .= 0
  shift .= 0

  for i .= 0; i <= mappings.length; i++
    c := mappings.charCodeAt i // NaN past the end
    if c is COMMA or c is SEMICOLON or i is mappings.length
      if shift or fieldCount is 2 or fieldCount is 3
        throw new Error "Malformed source map mappings"
      if fieldCount is 1
        current.push [colDelta]
      else if fieldCount
        current.push [colDelta, sourceIndex, srcLine, srcCol]
      fieldCount = 0
      if c is SEMICOLON
        current = []
        lines.push current
    else
      digit := c < 128 ? base64Values[c] : -1
      throw new Error "Malformed source map mappings" if digit < 0
      value += (digit & VLQ_VALUE_MASK) << shift
      if digit & VLQ_CONTINUATION_BIT
        shift += VLQ_SHIFT
      else
        field := value & 1 ? -(value >>> 1) : value >>> 1
        switch fieldCount++
          when 0 then colDelta = field
          when 1 then sourceIndex += field
          when 2 then srcLine += field
          when 3 then srcCol += field
        value = shift = 0

  lines

/**
The original `[sourceIndex, line, column]` of a position in a map's generated
code, or undefined when it's unmapped.  The column is interpolated from the
covering segment's start, since Hera's mapped tokens are copied verbatim from
the source.
*/
remapPosition := (lines: SourceMapEntry[][], line: number, column: number): [number, number, number] | undefined ->
  // The covering segment is the last one starting at or before `column`; an
  // unmapped segment ends the preceding mapping.
  let covering: SourceMapEntry | undefined
  start .= 0
  col .= 0
  for segment of lines[line] ?? []
    col += segment[0]
    break if col > column
    covering = segment
    start = col

  if covering?.length is 4
    [covering[1], covering[2], covering[3] + column - start]

/**
Compose two maps' lines: `downstream` maps final code to intermediate code
and `upstream` maps that intermediate code to the original source.  The
result maps final code to the original source.  Final positions whose
intermediate position has no upstream mapping are unmapped.  Unmapped
segments are kept only where they end a mapping; the rest carry nothing and
would only bloat the map.
*/
export composeLines := (upstream: SourceMapEntry[][], downstream: SourceMapEntry[][]): SourceMapEntry[][] ->
  downstream.map (entries) ->
    composed: SourceMapEntry[] := []
    colDelta .= 0 // columns since the last kept segment
    mapped .= false // whether the last kept segment is mapped
    for entry of entries
      colDelta += entry[0]
      position := if entry.length is 4 then remapPosition upstream, entry[2], entry[3]
      if position
        composed.push [colDelta, ...position]
      else if mapped
        composed.push [colDelta]
      else
        continue
      colDelta = 0
      mapped = !!position
    composed

export base64Encode := (src: string): string ->
  Buffer.from(src).toString "base64"

export class SourceMap
  lines: SourceMapEntry[][] = [[]]
  line = 0
  colOffset = 0
  srcLine = 0
  srcColumn = 0
  srcTable: number[]

  @(public source: string, public sourceFileName: string)
    @srcTable = locationTable source

  renderMappings(): string
    lastSourceLine .= 0
    lastSourceColumn .= 0

    @lines.map (line) ->
      line.map (entry) ->
        if entry.length is 4
          [colDelta, sourceFileIndex, srcLine, srcCol] := entry
          lineDelta := srcLine - lastSourceLine
          colDeltaSrc := srcCol - lastSourceColumn
          lastSourceLine = srcLine
          lastSourceColumn = srcCol
          `${encodeVlq colDelta}${encodeVlq sourceFileIndex}${encodeVlq lineDelta}${encodeVlq colDeltaSrc}`
        else
          encodeVlq entry[0]
      .join ","
    .join ";"

  json(outFileName: string): SourceMapJSON
    version: 3
    file: outFileName
    sources: [@sourceFileName]
    mappings: @renderMappings()
    names: []
    sourcesContent: [@source]

  /**
  Append `outputStr` to the generated output.  When `inputPos` is given, the
  appended text maps back to that position in the source (plus `colOffset`).
  Line `i` of the text maps to source line `i` after it, unless `anchored`,
  for generated code: then the text maps to `inputPos` itself, with a segment
  at every identifier.  A consumer may interpolate columns within a segment
  (Civet does), which would carry a generated column past the end of the
  source line.
  */
  updateSourceMap(outputStr: string, inputPos?: number, colOffset = 0, anchored = false): void
    outLines := outputStr.split EOL
    let srcLine = 0, srcCol = 0

    if inputPos?
      [srcLine, srcCol] = lookupLineColumn @srcTable, inputPos
      srcCol += colOffset
      @srcLine = srcLine
      @srcColumn = srcCol

    for each line, i of outLines
      if i > 0
        @line++
        @srcLine++
        @colOffset = 0
        @lines[@line] = []
        srcCol = colOffset unless anchored
        @srcColumn = srcCol

      l := @colOffset
      @colOffset = line.length
      @srcColumn += line.length

      if anchored
        @lines[@line].push [l, 0, srcLine, srcCol]
        segmentStart .= 0
        for { index } of line.matchAll /(?<![\w$])[\w$]/g
          continue if index is 0
          @lines[@line].push [index - segmentStart, 0, srcLine, srcCol]
          segmentStart = index
        @colOffset = line.length - segmentStart
      else if inputPos?
        @lines[@line].push [l, 0, srcLine + i, srcCol]
      else if l is not 0
        @lines[@line].push [l]

  /**
  Append pre-compiled `outputStr` whose lines already have composed source map
  entries (`mappedLines`) mapping back to this map's original source.
  */
  appendMapped(outputStr: string, mappedLines: SourceMapEntry[][]): void
    outLines := outputStr.split EOL
    for each line, i of outLines
      if i > 0
        @line++
        @colOffset = 0
        @lines[@line] = []
      entries := mappedLines[i]
      if entries and entries.length
        sum .= 0
        for e of entries
          sum += e[0]
        if @colOffset is 0
          @lines[@line].push ...entries
        else
          first := entries[0]
          shifted: SourceMapEntry := if first.length is 4
            [first[0] + @colOffset, first[1], first[2], first[3]] as SourceMapEntry
          else
            [first[0] + @colOffset] as SourceMapEntry
          @lines[@line].push shifted, ...entries.slice(1)
        @colOffset = line.length - sum
      else
        @colOffset += line.length
