export interface Loc {
  pos: number
  length: number
}

export interface Token {
  type: string
  children: unknown[]
  token: string
  loc: Loc
}

export interface ParseState {
  input: string
  pos: number
}

export interface ParseResult<T> {
  loc: Loc
  pos: number
  value: T
}

export type MaybeResult<T> = ParseResult<T> | undefined

/** Extract the inner value type from a `MaybeResult<T>` (or `ParseResult<T>`). */
export type Unwrap<R> = R extends ParseResult<infer T> ? T : never

export type Fail = (pos: number, expected: unknown) => void

/**
 * Sentinel returned from inlined rule handlers to signal "treat this rule as a
 * failed match" (reachable via the `$skip` parameter in hera grammars).
 */
export const SKIP: unique symbol = Symbol.for("@danielx/hera/SKIP") as any
export type SkipSymbol = typeof SKIP

/**
 * Sentinel returned by cursor-based rule functions to signal match failure.
 * Using a unique symbol allows valid rules to return `undefined`, `null`, `""`,
 * `0`, or `false` without boxing results in `{ loc, pos, value }` objects.
 */
export const FAIL: unique symbol = Symbol.for("@danielx/hera/FAIL") as any
export type FailSymbol = typeof FAIL

/**
 * Sentinel returned by `cacheEnter` to signal a cache miss.
 */
export const MISS: unique symbol = Symbol.for("@danielx/hera/MISS") as any
export type MissSymbol = typeof MISS

/**
 * Type-guard helper for TypeScript mode so checking `FAIL` on a value whose
 * static type may not include `typeof FAIL` (e.g. infallible `*`/`?` rules)
 * narrows cleanly without triggering TS2367.
 */
export function $isFail(v: unknown): v is typeof FAIL {
  return v === FAIL
}

export type ParserContext = {
  expectation: string
  fail: Fail
  /**
   * When true, rules marked `noMemo` still invoke `enter`/`exit` hooks
   * (used for full-coverage tracing / hit counting).
   */
  allEvents?: boolean
  enter?(name: string, state: ParseState): {
    /**
     * If a key named `cache` is present then its value is returned immediately
     */
    cache?: MaybeResult<unknown>
    /**
     * Data to pass to the exit event
     */
    data?: unknown
  } | undefined
  exit?(name: string, state: ParseState, result: MaybeResult<unknown>, data?: unknown): void
}

export interface CursorContext {
  input: string
  pos: number
  expectation: string
  fail?: Fail | undefined
  allEvents?: boolean
  memo?: MemoCache
  /**
   * Fast zero-allocation cache enter hook:
   * - return `MISS` on cache miss
   * - return `FAIL` on cached failure
   * - advance `ctx.pos` and return cached value directly on cached success
   */
  cacheEnter?(name: string, pos: number, ctx: CursorContext): unknown
  /**
   * Fast zero-allocation cache exit hook (`value === FAIL` on failure).
   */
  cacheExit?(name: string, startPos: number, endPos: number, value: unknown): void
}

/**
 * Built-in 2-way set-associative typed-array packrat memo cache.
 * Each memoized rule gets `MEMO_SETS` sets of 2 slots (`MEMO_SLOTS` total)
 * indexed by compile-time rule base offset + hashed `(pos, sk)`.
 */
export const MEMO_SETS = 64
export const MEMO_MASK = MEMO_SETS - 1
export const MEMO_SLOTS = MEMO_SETS * 2

export class MemoCache {
  readonly pos: Int32Array
  readonly state: Int32Array
  readonly end: Int32Array
  readonly val: unknown[]
  sk: number = 0
  /** Last slot index computed on a cache miss (reused by `$memoSet`/`$memoSet0`). */
  s: number = 0

  constructor(ruleCount: number) {
    const size = ruleCount * MEMO_SLOTS
    this.pos = new Int32Array(size)
    this.pos.fill(-1)
    this.state = new Int32Array(size)
    this.end = new Int32Array(size)
    this.val = new Array(size)
  }

  reset(): void {
    this.pos.fill(-1)
  }

  clearVals(): void {
    this.val.fill(undefined)
  }
}

export function createMemoCache(ruleCount: number): MemoCache {
  return new MemoCache(ruleCount)
}

export function $memoGet0(mc: MemoCache, base: number, p0: number, ctx: CursorContext): unknown {
  const s = base + ((p0 & MEMO_MASK) << 1)
  const pos = mc.pos
  if (pos[s] === p0) {
    const ep = mc.end[s]
    if (ep < 0) return FAIL
    ctx.pos = ep
    return mc.val[s]
  }
  const s1 = s + 1
  if (pos[s1] === p0) {
    const ep = mc.end[s1]
    if (ep < 0) return FAIL
    ctx.pos = ep
    return mc.val[s1]
  }
  mc.s = s
  return MISS
}

export function $memoSet0(mc: MemoCache, s: number, p0: number, endPos: number, val: unknown): void {
  const pos = mc.pos
  const end = mc.end
  const vals = mc.val
  const pPrev = pos[s]
  if (pPrev >= 0) {
    const s1 = s + 1
    pos[s1] = pPrev
    const ePrev = end[s]
    end[s1] = ePrev
    if (ePrev >= 0) vals[s1] = vals[s]
  }
  pos[s] = p0
  if (val === FAIL) {
    end[s] = -1
  } else {
    end[s] = endPos
    vals[s] = val
  }
}

export function $memoGet(mc: MemoCache, base: number, p0: number, sk: number, ctx: CursorContext): unknown {
  const mix = sk ^ (sk >>> 7) ^ (sk >>> 14) ^ (sk >>> 21)
  const s = base + (((p0 ^ mix) & MEMO_MASK) << 1)
  const pos = mc.pos
  const st = mc.state
  if (pos[s] === p0 && st[s] === sk) {
    const ep = mc.end[s]
    if (ep < 0) return FAIL
    ctx.pos = ep
    return mc.val[s]
  }
  const s1 = s + 1
  if (pos[s1] === p0 && st[s1] === sk) {
    const ep = mc.end[s1]
    if (ep < 0) return FAIL
    ctx.pos = ep
    return mc.val[s1]
  }
  mc.s = s
  return MISS
}

export function $memoSet(mc: MemoCache, s: number, p0: number, sk: number, endPos: number, val: unknown): void {
  const pos = mc.pos
  const st = mc.state
  const end = mc.end
  const vals = mc.val
  const pPrev = pos[s]
  if (pPrev >= 0) {
    const s1 = s + 1
    pos[s1] = pPrev
    st[s1] = st[s]
    const ePrev = end[s]
    end[s1] = ePrev
    if (ePrev >= 0) vals[s1] = vals[s]
  }
  pos[s] = p0
  st[s] = sk
  if (val === FAIL) {
    end[s] = -1
  } else {
    end[s] = endPos
    vals[s] = val
  }
}

export interface Parser<T> {
  (ctx: ParserContext, state: ParseState): MaybeResult<T>
}

export interface CursorParser<T> {
  (ctx: CursorContext): T | typeof FAIL
}

/**
 * Compile a pure top-level lookahead RegExp (`(?=...)` or `(?!...)`) into a
 * fast `(input, pos) => boolean` matcher. Single-character-class lookaheads
 * like `(?=[...])`, `(?![...])`, or `(?=[...]|$)` use a 128-entry ASCII lookup
 * table so ASCII inputs bypass the RegExp engine completely.
 */
const singleCharLookaheadRe = /^\(\?[=!]\[(?:\\.|[^\]\\])+\](?:\|\$)?\)$/

export function $la(re: RegExp): (input: string, pos: number) => boolean {
  const source = re.source
  if (singleCharLookaheadRe.test(source)) {
    const ascii = new Uint8Array(128)
    for (let c = 0; c < 128; c++) {
      re.lastIndex = 0
      ascii[c] = re.test(String.fromCharCode(c)) ? 1 : 0
    }
    re.lastIndex = 0
    const atEof = re.test("")
    return (input: string, pos: number) => {
      const c = input.charCodeAt(pos)
      if (c < 128) return ascii[c] === 1
      if (c !== c) return atEof // NaN => EOF
      re.lastIndex = pos
      return re.test(input)
    }
  }
  return (input: string, pos: number) => {
    re.lastIndex = pos
    return re.test(input)
  }
}

/**
 * Compile a simple character-class RegExp (single atom `[...]`/`\s`/`\d`/`\w`/`.`
 * with optional `+`/`*`/`?`, or ASCII identifier pattern `[start][cont]*` with
 * optional negative lookahead `(?![stop])`) into a fast `(input, pos) => number`
 * matcher returning the match end index (or `-1` on failure) without allocating
 * a `RegExpMatchArray` or invoking V8's RegExp engine on ASCII inputs.
 */
const ccSingleRe = /^(\[(?:\\.|[^\]\\])+\]|\\s|\\d|\\w|\.)([+*?])?$/
const ccIdentRe = /^(\[(?:\\.|[^\]\\])+\])(\[(?:\\.|[^\]\\])+\])([*+])(?:\(\?!(\[(?:\\.|[^\]\\])+\])\))?$/

export function isCharClassRe(source: string): boolean {
  return ccSingleRe.test(source) || ccIdentRe.test(source)
}

function isAsciiOnlyAtom(atom: string): boolean {
  if (atom === "." || atom.startsWith("[^") || atom === "\\s") return false
  if (/\\[sSdDwWpPuUx]/.test(atom)) return false
  for (let i = 0; i < atom.length; i++) {
    if (atom.charCodeAt(i) >= 128) return false
  }
  return true
}

function buildAsciiTable(atomRe: RegExp): Uint8Array {
  const ascii = new Uint8Array(128)
  for (let c = 0; c < 128; c++) {
    atomRe.lastIndex = 0
    ascii[c] = atomRe.test(String.fromCharCode(c)) ? 1 : 0
  }
  return ascii
}

export function $cc(re: RegExp): (input: string, pos: number) => number
  source := re.source
  m1 := ccSingleRe.exec(source)
  if m1
    atom := m1[1]
    quant := m1[2] || ""
    charRe := new RegExp(atom, "suy")
    ascii := buildAsciiTable(charRe)
    asciiOnly := isAsciiOnlyAtom(atom)

    if quant is "+" or quant is "*"
      requireOne := quant is "+"
      if asciiOnly
        return (input: string, pos: number) =>
          p .= pos
          len := input.length
          while p < len
            c := input.charCodeAt(p)
            break if c >= 128 or !ascii[c]
            p++
          if requireOne and p is pos then -1 else p
      return (input: string, pos: number) =>
        p .= pos
        len := input.length
        while p < len
          c := input.charCodeAt(p)
          if c < 128
            break if !ascii[c]
            p++
          else
            charRe.lastIndex = p
            m := charRe.exec(input)
            break if !m
            p += m[0].length
        if requireOne and p is pos then -1 else p

    // Single character (`""`) or optional single character (`"?"`)
    optional := quant is "?"
    if asciiOnly
      return (input: string, pos: number) =>
        c := input.charCodeAt(pos)
        if c < 128 and ascii[c] then pos + 1 else (if optional then pos else -1)
    return (input: string, pos: number) =>
      c := input.charCodeAt(pos)
      if c < 128
        return if ascii[c] then pos + 1 else (if optional then pos else -1)
      return (if optional then pos else -1) if c !== c
      charRe.lastIndex = pos
      m := charRe.exec(input)
      if m then pos + m[0].length else (if optional then pos else -1)

  m2 := ccIdentRe.exec(source)
  if m2 and isAsciiOnlyAtom(m2[1]) and isAsciiOnlyAtom(m2[2])
    ascii1 := buildAsciiTable(new RegExp(m2[1], "suy"))
    ascii2 := buildAsciiTable(new RegExp(m2[2], "suy"))
    requireCont := m2[3] is "+"
    stopAtom := m2[4]
    stopRe := if stopAtom then new RegExp(stopAtom, "suy") else undefined
    asciiStop := if stopRe then buildAsciiTable(stopRe) else undefined
    stopAsciiOnly := if stopAtom then isAsciiOnlyAtom(stopAtom) else true
    return (input: string, pos: number) =>
      len := input.length
      return -1 if pos >= len
      c0 := input.charCodeAt(pos)
      return -1 if c0 >= 128 or !ascii1[c0]
      p .= pos + 1
      while p < len
        c := input.charCodeAt(p)
        break if c >= 128 or !ascii2[c]
        p++
      return -1 if requireCont and p is pos + 1
      if asciiStop and p < len
        cs := input.charCodeAt(p)
        hitStop := if cs < 128
          asciiStop[cs] is 1
        else if !stopAsciiOnly
          stopRe!.lastIndex = p
          stopRe!.test(input)
        else
          false
        if hitStop
          // Backtrack via the original regex (e.g. /[a][b]*(?![x])/ on "abx" -> "a")
          re.lastIndex = pos
          m := re.exec(input)
          return if m then pos + m[0].length else -1
      p

  return (input: string, pos: number) =>
    re.lastIndex = pos
    m := re.exec(input)
    if m then pos + m[0].length else -1

/**
 * Wire `events` onto a `CursorContext`. Fast `cacheEnter`/`cacheExit` hooks are
 * attached directly; legacy `enter`/`exit` hooks are adapted once per parse so
 * generated rules only check a single fast hook.
 */
export function $adaptEvents(ctx: CursorContext, events: ParserEvents): void
  ctx.allEvents = true if events.allEvents
  { cacheEnter, cacheExit, enter, exit } := events
  if cacheEnter or cacheExit
    ctx.cacheEnter = cacheEnter if cacheEnter
    ctx.cacheExit = cacheExit if cacheExit
    return
  return if not enter and not exit
  const stateStack: ParseState[] = []
  const dataStack: unknown[] = []
  if (enter) {
    ctx.cacheEnter = (name: string, pos: number, c: CursorContext) => {
      const st: ParseState = { input: c.input, pos }
      const res = enter(name, st)
      if (res && "cache" in res) {
        const cached = res.cache
        if (!cached) return FAIL
        c.pos = cached.pos
        return cached.value
      }
      if (exit) {
        stateStack.push(st)
        dataStack.push(res?.data)
      }
      return MISS
    }
  } else if (exit) {
    ctx.cacheEnter = (_name: string, pos: number, c: CursorContext) => {
      stateStack.push({ input: c.input, pos })
      dataStack.push(undefined)
      return MISS
    }
  }
  if (exit) {
    ctx.cacheExit = (name: string, startPos: number, endPos: number, value: unknown) => {
      const st = stateStack.pop()!
      const data = dataStack.pop()
      const res: MaybeResult<unknown> = value === FAIL ? undefined : {
        loc: { pos: startPos, length: endPos - startPos },
        pos: endPos,
        value,
      }
      exit(name, st, res, data)
    }
  }

/**
 * Adapt an internal cursor-based rule function to the legacy exported
 * `(ctx: ParserContext, state: ParseState) => MaybeResult<T>` signature.
 */
export function $wrap<R>(
  fn: (ctx: CursorContext) => R,
  ctx: ParserContext,
  state: ParseState
): MaybeResult<Exclude<R, typeof FAIL>> {
  const c: CursorContext = {
    input: state.input,
    pos: state.pos,
    expectation: ctx.expectation,
    fail: ctx.fail,
  }
  if (ctx.allEvents || ctx.enter || ctx.exit) {
    $adaptEvents(c, ctx)
  }
  const val = fn(c)
  if (val === FAIL) return undefined
  return {
    loc: { pos: state.pos, length: c.pos - state.pos },
    pos: c.pos,
    value: val as Exclude<R, typeof FAIL>,
  }
}

// End of machinery
// Parser specific things below

export function Validator() {
  const failHintRegex = /\S+|\s+|$/y

  // Error tracking
  // Goal is zero allocations
  const failExpected = Array(16)
  let failIndex = 0
  let maxFailPos = 0

  function fail(pos: number, expected: unknown) {
    if (pos < maxFailPos) return

    if (pos > maxFailPos) {
      maxFailPos = pos
      failExpected.length = failIndex = 0
    }

    failExpected[failIndex++] = expected

    return
  }

  /**
  * Utility function to convert position in a string input to 1 based line:column.
  * Handles LF, CRLF, and CR line endings; a position inside a CRLF pair
  * reports as the last column of the line it terminates.
  */
  function location(input: string, pos: number): [number, number] {
    const lineEnding = /\r\n|\n|\r/g
    let line = 1, lineStart = 0, m
    while ((m = lineEnding.exec(input)) && m.index + m[0].length <= pos) {
      line++
      lineStart = m.index + m[0].length
    }
    return [line, pos - lineStart + 1]
  }

  function validate<T>(input: string, result: MaybeResult<T>, { filename }: { filename: string }): T {
    if (result && result.pos === input.length)
      return result.value

    const expectations = Array.from(new Set(failExpected.slice(0, failIndex)))

    // The parse completed with a result but there is still input. Report it
    // unless a failure was recorded further along, which is more informative.
    if (result && (result.pos > maxFailPos || !expectations.length)) {
      const [line, column] = location(input, result.pos)
      throw new Error(`${filename}:${line}:${column} Unconsumed input

${input.slice(result.pos)}
`)
    }

    if (expectations.length) {
      const [line, column] = location(input, maxFailPos)
      failHintRegex.lastIndex = maxFailPos
      let [hint] = input.match(failHintRegex)!

      if (hint.length)
        hint = JSON.stringify(hint)
      else
        hint = "EOF"

      const error = new ParseError("Failed to parse", `Expected:
\t${expectations.join("\n\t")}
Found: ${hint}
`, filename, line, column, maxFailPos)

      throw error
    }

    throw new Error("No result")
  }

  function reset() {
    failIndex = 0
    maxFailPos = 0
    failExpected.length = 0
  }

  return {
    fail,
    validate,
    reset,
  }
}

export class ParseError extends Error {
  name = "ParseError" as const
  constructor(
    public header: string,
    public body: string | undefined,
    public filename: string,
    public line: number,
    public column: number,
    public offset: number,
  ) {
    let message = `${filename}:${line}:${column} ${header}`
    if (body) message += `\n${body}`
    super(message)
    this.message = message
  }
}

export type ParserEvents = {
  allEvents?: boolean,
  enter?: ParserContext["enter"],
  exit?: ParserContext["exit"],
  cacheEnter?: CursorContext["cacheEnter"],
  cacheExit?: CursorContext["cacheExit"],
}

export type HeraGrammar = { [key: string]: Parser<any> | CursorParser<any> }

export interface ParserOptions<T extends HeraGrammar> {
  /** The name of the file being parsed */
  filename?: string
  startRule?: keyof T
  events?: ParserEvents
  /**
   * Enable built-in packrat memoization:
   * - `true`: acquire a pooled `MemoCache` automatically for this parse
   * - `MemoCache`: use a caller-managed `MemoCache` (allowing state key `sk` updates and `reset()`)
   */
  memo?: boolean | MemoCache
  /**
   * Skip recording failure expectations on the initial parse pass and only
   * re-run with full error tracking if the parse actually fails. Safe for
   * idempotent grammars (e.g. grammars with a Reset rule).
   */
  lazyErrors?: boolean
}

// Minimal legacy combinators kept solely for backwards compatibility with
// parsers compiled by earlier Hera versions (including @danielx/hera-previous
// during Hera's own bootstrap). Newly compiled parsers do not import these.
type Expectation = string | (() => string)
export function $EXPECT<T>(parser: Parser<T>, expectation: Expectation): Parser<T> {
  return (ctx, state) => {
    const r = parser(ctx, state)
    if (!r) ctx.fail(state.pos, typeof expectation === "function" ? expectation() : expectation)
    return r
  }
}
export function $L<const S extends string>(str: S): Parser<S> {
  const l = str.length
  return (_ctx, { input, pos }) => {
    if (input.startsWith(str, pos)) return { loc: { pos, length: l }, pos: pos + l, value: str }
    return
  }
}
export function $R<T extends unknown[] = RegExpMatchArray>(re: RegExp): Parser<T> {
  return (_ctx, { input, pos }) => {
    re.lastIndex = pos
    const m = re.exec(input)
    if (m) return { loc: { pos, length: m[0].length }, pos: pos + m[0].length, value: m as unknown as T }
    return
  }
}
export function $R$0<S>(parser: Parser<ArrayLike<S>>): Parser<S> {
  return (ctx, state) => {
    const r = parser(ctx, state)
    if (!r) return
    ;(r as any).value = r.value[0]
    return r as unknown as ParseResult<S>
  }
}
export function $C(...terms: Parser<any>[]): Parser<any> {
  return function (ctx, state) {
    for (let i = 0; i < terms.length; i++) {
      const r = terms[i](ctx, state)
      if (r) return r
    }
    return
  }
}
export function $S(...terms: Parser<any>[]): Parser<any> {
  return function (ctx, state) {
    const results: any[] = []
    let { pos } = state
    const { input } = state
    for (let i = 0; i < terms.length; i++) {
      const r = terms[i](ctx, { input, pos })
      if (!r) return
      results.push(r.value)
      pos = r.pos
    }
    return { loc: { pos: state.pos, length: pos - state.pos }, pos, value: results }
  }
}
export function $E<T>(fn: Parser<T>): Parser<T | undefined> {
  return (ctx, state) => fn(ctx, state) ?? { loc: { pos: state.pos, length: 0 }, pos: state.pos, value: undefined }
}
export function $Q<T>(fn: Parser<T>): Parser<T[]> {
  return (ctx, state) => {
    const results: T[] = []
    let { pos } = state
    const { input } = state
    while (true) {
      const r = fn(ctx, { input, pos })
      if (!r || r.pos === pos) break
      pos = r.pos
      results.push(r.value)
    }
    return { loc: { pos: state.pos, length: pos - state.pos }, pos, value: results }
  }
}
export function $P<T>(fn: Parser<T>): Parser<T[]> {
  return (ctx, state) => {
    const first = fn(ctx, state)
    if (!first) return
    const results: T[] = [first.value]
    let pos = first.pos
    const { input } = state
    while (true) {
      const r = fn(ctx, { input, pos })
      if (!r || r.pos === pos) break
      pos = r.pos
      results.push(r.value)
    }
    return { loc: { pos: state.pos, length: pos - state.pos }, pos, value: results }
  }
}
export function $TEXT(fn: Parser<unknown>): Parser<string> {
  return (ctx, state) => {
    const r = fn(ctx, state)
    if (!r) return
    ;(r as any).value = state.input.substring(state.pos, r.pos)
    return r as ParseResult<string>
  }
}
export function $N(fn: Parser<unknown>): Parser<true> {
  return (ctx, state) => fn(ctx, state) ? undefined : { loc: { pos: state.pos, length: 0 }, pos: state.pos, value: true }
}
export function $Y(fn: Parser<unknown>): Parser<true> {
  return (ctx, state) => fn(ctx, state) ? { loc: { pos: state.pos, length: 0 }, pos: state.pos, value: true } : undefined
}
export function $T<A, B>(parser: Parser<A>, fn: (v: A) => B): Parser<B> {
  return (ctx, state) => {
    const r = parser(ctx, state)
    if (!r) return
    ;(r as any).value = fn(r.value)
    return r as unknown as ParseResult<B>
  }
}
export function $TR(parser: Parser<any>, fn: (...args: any[]) => any): Parser<any> {
  return (ctx, state) => {
    const r = parser(ctx, state)
    if (!r) return
    const v = fn(SKIP, r.loc, ...r.value)
    if (v === SKIP) return
    ;(r as any).value = v
    return r
  }
}
export function $TS(parser: Parser<any>, fn: (...args: any[]) => any): Parser<any> {
  return (ctx, state) => {
    const r = parser(ctx, state)
    if (!r) return
    const v = fn(SKIP, r.loc, r.value, ...r.value)
    if (v === SKIP) return
    ;(r as any).value = v
    return r
  }
}
export function $TV(parser: Parser<any>, fn: (...args: any[]) => any): Parser<any> {
  return (ctx, state) => {
    const r = parser(ctx, state)
    if (!r) return
    const v = fn(SKIP, r.loc, r.value, r.value)
    if (v === SKIP) return
    ;(r as any).value = v
    return r
  }
}
export function $EVENT<T>(ctx: ParserContext, state: ParseState, name: string, fn: Parser<T>) {
  const res = ctx.enter?.(name, state)
  if (res && "cache" in res) return res.cache as MaybeResult<T>
  const r = fn(ctx, state)
  ctx.exit?.(name, state, r, res?.data)
  return r
}
export function $EVENT_C(ctx: ParserContext, state: ParseState, name: string, fns: Parser<any>[]) {
  const res = ctx.enter?.(name, state)
  if (res && "cache" in res) return res.cache
  let r: MaybeResult<any>
  for (let i = 0; i < fns.length && !r; i++) r = fns[i](ctx, state)
  ctx.exit?.(name, state, r, res?.data)
  return r
}
